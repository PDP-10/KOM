;TOPS20AN JSYS DEFINITIONS

DEFJS SEND,740,MSEC1      	;TOPS20AN, BBN TCP JSYS Interface
DEFJS RECV,741,MSEC1      	;TOPS20AN, BBN TCP JSYS Interface
DEFJS OPEN,742,MSEC1      	;TOPS20AN, BBN TCP JSYS Interface
DEFJS CLOSE,743,MSEC1     	;TOPS20AN, BBN TCP JSYS Interface
DEFJS SCSLV,744,MSEC1     	;TOPS20AN, BBN TCP JSYS Interface
DEFJS STAT,745,MSEC1      	;TOPS20AN, BBN TCP JSYS Interface
DEFJS CHANL,746,MSEC1     	;TOPS20AN, BBN TCP JSYS Interface
DEFJS ABORT,747,MSEC1     	;TOPS20AN, BBN TCP JSYS Interface
DEFJS SNDIM,750,MSEC1,,OLD 	;TOPS20AN, Send IMP Special Queue Message
DEFJS RCVIM,751,MSEC1,,OLD 	;TOPS20AN, Receive IMP Special Queue Message
DEFJS ASNSQ,752,MSEC1,,OLD 	;TOPS20AN, Assign IMP Special Queue
DEFJS RELSQ,753,MSEC1,,OLD 	;TOPS20AN, Release IMP Special Queue
DEFJS SNDIN,754,MSEC1     	;TOPS20AN, Send Internet Message
DEFJS RCVIN,755,MSEC1     	;TOPS20AN, Receive Internet Message
DEFJS ASNIQ,756,MSEC1     	;TOPS20AN, Assign Internet Queue
DEFJS RELIQ,757,MSEC1     	;TOPS20AN, Release Internet Queue
DEFJS IPOPR,760,MSEC1		;TOPS20AN, IP Functions JSYS
DEFJS TCOPR,761,MSEC1		;TOPS20AN, TCP Functions JSYS

;TEMPORARY JSYS DEFINITIONS

DEFJS METER,766,MSEC1		;METER JSYS. FOR KL ONLY
DEFJS SMAP,767,MSEC1		;CREATE AND MAP SECTIONS
DEFJS THIBR,770,MSEC1,,OLD
DEFJS TWAKE,771,MSEC1,,OLD
DEFJS MRPAC,772,MSEC1,,OLD
DEFJS SETPV,773,,NIM,OLD
DEFJS MTALN,774,MSEC1,,OLD
DEFJS TTMSG,775,MSEC1,,OLD
DEFJS MDDT,777,MSEC1
	PURGE	kaka


	EXP	%run##			;<KPJ.142> running somewhere
	EXP	%jsys##			;<KPJ.142> waiting fo a JSYS
ststab:	EXP	1+ttinp0,%texti##	;<KPJ.245!KPJ.142> waiting for input
	EXP	mkenqx,%mkenq##		;<KPJ.142> waiting for ENQ%
	EXP	1+inblx##,%inblk##	;<KPJ.145> waiting for data base
	EXP	1+outblx##,%utblk##	;<KPJ.145>  - - - " " - - -
	0				;<KPJ.142> end of table
;-


;+
REPEAT	0,<			;<KPJ.67>
;CGINT	^G interrupt routine (not documented)
;-

cgint:	save	<1,2>		;[KPJ.2] Used by TTYCLR
	CALL	ttyclr
	Tmsg	<^G
>
	SETZM	linpos##
	SETOM	abortf		;set abort flag
	rstreg			;[KPJ.2] Restore used ACs
	DEBRK%			;Return from interrupt
>;REPEAT 0			;<KPJ.67>

;+
;COINT	^O interupt routine (not documented)
;-

coint:	save	<1,2>
	MOVEI	1,.PRIOUT
	RFMOD%
	TLCE	2,(TT%OSP)	;toggle output suppress bit
	 JRST	coint9		;if it was on already, just go do the SFMOD%
	CFOBF%			;clear output buffer
	Tmsg	<^O
>
	MOVEI	1,.PRIOUT
coint9:	SFMOD%
	rstreg
	DEBRK%			;Return from interrupt
>;T20

;+
;TTYCLR	(not documented)
;OSPCLR	(not documented)
;-

T20,<
ttyclr:	MOVEI	1,.PRIOUT
	CFOBF%				;clear output buffer
	Fall	ospclr			;<KPJ.245>
>;T20
ospclr::
T10,<	MOVE	t1,[3,,[EXP .TOOSU+.TOSET,-1,0]] ;<KPJ.102>
	TRMOP.	t1,			;<KPJ.102> clear suppress-output bit
	 nop				;<KPJ.102> ***FOO*** should't fail
>;T10
T20,<	MOVEI	1,.PRIOUT		;clear suppress-output bit
	RFMOD%
	TLZE	2,(TT%OSP)
	 SFMOD%
>;T20
	return


;+
;MKENQ		make enque
;-

mkenq::
T10,<	save	<gp1>
	CALL	toutpu			; output terminal buffer
>;T10
	SKIPE	havenq##		;<TEQ!KPJ.46> already have resource?
	 error	<mkenq-1 monito>	;<TEQ!KPJ.46> yes, bug in program
T10,<	SETOM	enqwat##		;<TEQ> indicate we are waiting
	MOVE	t,[.ENQSI,,enqblk]	;<KPJ.130!TEQ> DON'T allow blocking
	ENQ.	t,
	 TRNA				;[TEQ] couldn't now, wait for interrupt
	  JRST	mkenq8			;[TEQ]
	CAIN	t,ENQRU%		;<TTQ!KPJ.123> resource not available?
	 JRST	mkenq0			;<KPJ.123> yes
	CAIN	t,ENQQE%		;<KPJ.123> ENQ quota exceeded
	 JRST[	SKIPN	noenqp		;<KPJ.123> already crashed with this?
		 CALL[	print	zmkenq##	;<KPJ.123> "ENQ quota exceeded"
			SETOM	noenqp		;<KPJ.123>
			RET]			;<KPJ.201>
		SETZM	enqwat##	;<KPJ.123> not waiting any more
		JRST	endkom##]	;<KPJ.123> give up
	 error	<mkenq-2 monito>	;no, something else
					;<KPJ.137>

mkenq0:					;<KPJ.123> yes, let's wait for it
IFGE	<enqsl1-maxhib>,<PRINTX ? HIBER nap time too large in MKENQ>
	MOVE	t,[HB.RWJ+enqsl1]	;[TEQ] take a short nap
	HIBER	t,			;zzzzzz
	 warn	<monito mkenq hiber nap>;[KPJ.41]
	SKIPE	havenq##		;have ENQ. lock yet?
	 JRST	mkenq9			;yes
	MOVEI	gp1,enqsl3			;<KPJ.141> set a counter
IFGE	<enqsl2-maxhib>,<PRINTX ? HIBER max time too large in MKENQ>
mkenq3:	MOVE	t,[HB.RWJ+^D1000*enqsl2]	;[TEQ] protect from others
	HIBER	t,				;[TEQ] sleep awhile
	 warn	<monito mkenq hiber sleep>	;[KPJ.41!TEQ]
	SKIPE	havenq##			;<TEQ> OK if interrupt got it
	 JRST	mkenq9				;[TEQ]
	SOJG	gp1,mkenq3			;[TEQ] rept, HIBER may failed?
	SKIPE	noenqq##			;<KPJ.130> yelled about this?
	 JRST[	print	mkenqq##		;<KPJ.130> say what happened
		JRST	.+1]			;<KPJ.201>
	SETOM	noenqq##			;<KPJ.130> remember we yelled
	SETOM	noenqp##			;<KPJ.130> no ENQ quota
	SETZM	enqwat##			;<KPJ.130> not waiting any more
	JRST	endkom##			;<KPJ.130> go and die

mkenq8:	SETOM	havenq##		;<TEQ> yes, we are in
mkenq9:	SETZM	enqwat##		;<TEQ> no, no longer waiting
>;T10
T20,<	HRRZ	1,@curcha##		;<KPJ.201> get JFN
	MOVEM	1,enqblk##+.ENQLV	;store in ENQ% block
	MOVEI	1,.ENQBL
	MOVEI	2,enqblk##
	ENQ%
mkenqx:	 error	<mkenq-2 monito>	;<KPJ.142>
	SETOM	havenq##		;<KPJ.46> have resource now
>;T20
	return


;+
;MKDEQ		make deque
;-

mkdeq::
T10,<	MOVE	t,[.DEQDR,,enqblk]	;<TEQ> dequeue specific request
	DEQ.	t,			;get rid of it
>;T10
T20,<	HRRZ	1,@curcha##		;get JFN
	MOVEM	1,enqblk##+.ENQLV	;store in DEQ% block
	MOVEI	1,.DEQDR
	MOVEI	2,enqblk##
	DEQ%
>;T20
	 error	<mkdeq monito>			;DEQ./DEQ% failed...
	SETZM	havenq##		;<KPJ.46!TEQ> we have no resource
	return


;+
;DEQUE		dequeue all pending requests
;-

deque::	SKIPE	havenq##		;<KPJ.45> have resource?
	 JRST	deque1			;<KPJ.41> yes, get rid of it
T10,<	SKIPN	enqwat##>		;<KPJ.45> no, waiting for it?
	 JRST	deque2			;[KPJ.41] no, get lost
deque1:					;[KPJ.41] either have or waiting
T10,<	MOVE	t,[.DEQDA,,enqblk]	;[TEQ] deque all locks etc
	DEQ.	t,			; dequeue all pending requests
>;T10
T20,<	MOVEI	1,.DEQDA
	DEQ%
>;T20
	 warn	<monito deque>		;[KPJ.41] ignore errors
deque2:	SETZM	havenq##		;<KPJ.46!TEQ> we have no resource 
	return



T10,<
;RUNX		call program (T10 only)
;T10:		GP1/	flags+offset,,run block
;			flags:
;				1B1:	use UU.PHY		<KPJ.110>
;T20:		GP1/	offset,filename string addr

runx::	MOVEM	0,acblk##+0		;<KPJ.143> save AC 0
	MOVE	0,[1,,acblk##+1]	;<KPJ.143> from,,to
	BLT	0,acblk##+^O17		;<KPJ.143> save AC1 .. AC17
	CALL	runxx##			;<KPJ.143> go to low segment
	PORTAL	xxback			;<KPJ.207> failed, tell user about it
>;T10

T10,<
;BADPRG		say we couldn't, what program we couldn't load, and why
;accepts	RUNBLK/	RUN/GETSEG argument block:
;		+0	device name (SIXBIT)
;		+1	file name (SIXBIT)
;		+2	extension (SIXBIT)
;		+3	0 (ignored)
;		+4	path pointer (PPN is allowed, normally never used)
;		PATH block:
;		+0	0 (ignored)
;		+1	0 (ignored)
;		+2	P,,PN
;		+3	SFD list (in SIXBIT)
;		 :
;		+n	0 (end of SFD list)

badprg:	print	zrun01##		;<KPJ.143> "cannot run program "
	MOVE	gp1,runblk##+0		;<KPJ.143> get device name
	CALL	prcin3			;<KPJ.143> output SIXBIT device name
	MOVEI	ch,":"			;<KPJ.143> end it with ":"
	CALL	putch			;<KPJ.143>
	MOVE	gp1,runblk##+1		;<KPJ.143> get file name
	CALL	prcin3			;<KPJ.143> output it
	SKIPE	gp1,runblk##+2		;<KPJ.143> is it defined?
	 JRST[	MOVEI	ch,"."		;<KPJ.143> yes, start of extension
		CALL	putch		;<KPJ.143> 
		CALL	prcin3		;<KPJ.143> output extension
		JRST	.+1]		;<KPJ.143>
	SKIPN	gp1,runblk##+4		;<KPJ.143> is it defined?
	 JRST	xnoppn			;<KPJ.143> no, we are done
	HLRZ	t,gp1			;<KPJ.214> PPN or path?
	JUMPE	t,[			;<KPJ.214> a path
		HRRZ	t,gp1		;<KPJ.214> get path pointer
		SKIPN	2(t)		;<KPJ.214> any PPN out there?
		 JRST	xnoppn		;<KPJ.214> no
		JRST	.+1]		;<KPJ.214> yes, continue
	MOVEI	ch,ppnbeg		;<KPJ.143> start a path or PPN
	CALL	putch			;<KPJ.143> . . .
	HLRZ	t,gp1			;<KPJ.143> is it a PPN or a path?
	JUMPN	t,[			;<KPJ.143> a PPN
		CALL	prippn		;<KPJ.143> output PPN
		JRST	xdone]		;<KPJ.143> end of PPN
	ADDI	gp1,2			;<KPJ.143> skip two first words
	PUSH	P,gp1			;<KPJ.210> save away address
	SKIPN	gp1,@gp1		;<KPJ.214!KPJ.210!KPJ.143> get PPN
	 JRST[	POP	P,gp1		;<KPJ.214> no PPN, exit fast
		JRST	xdone]		;<KPJ.214> . . .
	CALL	prippn##		;<KPJ.143> output PPN
xxlupe:	POP	P,t2			;<KPJ.210> get back address
	ADDI	t2,1			;<KPJ.210!KPJ.143> step to next SFD
	SKIPN	gp1,@t2			;<KPJ.210!KPJ.143> get next SFD
	 JRST	xdone			;<KPJ.210!KPJ.143> done?
	PUSH	P,t2			;<KPJ.210> no, save away address
	MOVEI	ch,","			;<KPJ.143> output comma
	CALL	putch			;<KPJ.143>
	CALL	prcin3			;<KPJ.143> output SFD name
	JRST	xxlupe			;<KPJ.143> go for next level if any
xdone:	MOVEI	ch,ppnend		;<KPJ.143> end of PPN
	CALL	putch			;<KPJ.143> say so
	
xnoppn:	MOVE	gp1,xerror##		;<KPJ.143> get error code
	CALL	badfil##		;<KPJ.143> output error message
	CALL	preol##			;<KPJ.143> 
	return
>;T10

T10,<
;GRRBLC		save program spec in RUNBLK	<KPJ.212>
;accepts	GP1/	pointer to FILOP. argument block
;returns	+1 always, with
;			RUNBLK/ RUN block
;			GP1/	pointer to RUNBLK

grrblc::MOVE	t,.FODEV(gp1)		;copy device name
	MOVEM	t,runblk##+0		;. . .
	HRRZ	t2,.FOLEB(gp1)		;get LOOKUP block address
	MOVE	t,.RBNAM(t2)		;copy file name
	MOVEM	t,runblk##+1		;. . .
	MOVE	t,.RBEXT(t2)		;copy extension
	MOVEM	t,runblk##+2		;. . .
	SETZM	runblk##+3		;always zero
	MOVEI	t,xpath##		;copy PATH. pointer
	MOVEM	t,runblk##+4		;. . .
	SETZM	runblk##+5		;no core assignment
	SETZM	xpath##+0		;clear PATH. flags
	SETZM	xpath##+1		;. . .
	HRRZ	t2,.FOPAT(gp1)		;get PATH. pointer
	ADDI	t2,2			;skip two first words
	HRLZ	t2,t2			;from,,0
	HRRI	t2,xpath##+2		;from,,to
	BLT	t2,xptend##		;copy path
	SETZM	xptend##		;end of list
	MOVEI	gp1,runblk##		;return pointer
	return
>;T10


T10,<
;GRRBLK		save program spec in RUNBLK	<KPJ.210>
;accepts	GP1/	pointer to 6-word RUN/GETSEG block
;returns	+1 failed, with STR/ pointer to error message
;		+2 success, with
;			RUNBLK/ RUN block
;			GP1/	pointer to RUNBLK

grrblk::MOVS	t,gp1			;get blockaddress,,0
	HRRI	t,runblk##		;merge in 0,,target
	BLT	t,runblk##+3-1		;store device, file name and extension
	SETZM	runblk##+3		;always zero
	MOVEI	t,xpath##		;PATH. pointer
	MOVEM	t,runblk##+4		;save in RUNBLK
	SETZM	runblk##+5		;no core argument
	SETZM	xpath##+0		;clear away any garbage
	SETZM	xpath##+1		;. . . .
	HLRZ	t,4(gp1)		;get LH of PPN or path pointer
	JUMPN	t,[			;PPN?
		MOVE	t,4(gp1)	;yes, store in RUN block
		MOVEM	t,xpath##+2	;. . .
		SETZM	xpath##+3	;no SFDs
		JRST	grrbl8]		;done
	HRRZ	t2,gp1			;get source path pointer
	ADDI	t2,3			;. . . .
	MOVEI	t3,xpath##+2		;get target path pointer
grrbl1:	CAIN	t3,xptend##		;target PATH. block full?
	 JRST[	MOVEI	str,zgrrbl##	;tell user we failed
		JRST	grrbl9]		;yes, error
	MOVE	t,0(t2)			;copy PATH. block
	MOVEM	t,0(t3)			;. . . .
	JUMPE	t,grrbl8		;end of SFD list?
	ADDI	t2,1			;step to next word
	AOJA	t3,grrbl1		;. . . .
grrbl8:	skpret	
	HRRI	gp1,runblk		;now point at real world
grrbl9:	return
>;T10

T10,<	;*** NOTE: No SAVE macro here please --- we never return ***

;GETX		routine to load in a new high segment (will dequeue data base
;		to not get any spurious interrupts while in nowhere land).

;accepts	GP1/	address of GETSEG argument block
;returns	(1)	+1 if we fail to load in the new segment, but succeed
;			to load back this (the original) segment (we return
;			via GOBACK routine), or if we cannot save the RUN block
;			in the low segment
;		(2)	to top loop of new high segment, if succeed to load it
;			(we return through SEGRET in that segment)
;		(3)	to monitor with an error message if fails to load in
;			both the new segment as well as the original one (we
;			die in XXARGH routine)

getx::	CALL	grrblk			;<KPJ.210> save program name in RUNBLK
	 JRST[	CALL	errmsg##	;<KPJ.210> can't do that, tell user
		JRST	getx9]		;<KPJ.210> and give up
	CALL	takoff			;<KPJ.202> Preparing for launching, Sir
	MOVEM	0,acblk##+0		;<KPJ.201> save away ACs
	MOVE	0,[1,,acblk##+1]	;<KPJ.201> . . .
	BLT	0,acblk##+^O17		;<KPJ.201> . . .
	CALL	getxx##			;<KPJ.201> go to LOWSEG routine to
					;<KPJ.202> kill this segment and try
					;<KPJ.202> to load in a new one.
	PORTAL	.+1			;<KPJ.207> entry point from low segment
					;<KPJ.207> in case we are concealed

;We come here when a GETSEG failed to load in a new high segment, and we did
;succeed in getting back our original high segment.  Unfortunately, the JOBDAT
;area is a mess, because GETSEG does not initialize it, but does clear away
;some usefull information.  Put it back so we don't crash so often...

	MOVE	t,[-2,,.GTUPM]		;<KPJ.202> us
	GETTAB	t,			;<KPJ.202> get high segment start
	 MOVEI	t,evec-.JBHDA		;<KPJ.202> failed, try this (gulp!)
	HLRZ	t,t			;<KPJ.202> get origin
	CAIN	t,0			;<KPJ.202> no start address??
	 MOVEI	t,evec-.JBHDA		;<KPJ.202> failed, try this (gulp!)
;	ADDI	t,.JBHSA		;<KPJ.202> use word word 0 (.JBHSA)
	MOVE	t,0(t)			;<KPJ.202> restore RH(.JBSA) from this
	HRRM	t,.JBSA			;<KPJ.201> . . .
	MOVE	t,myree			;<KPJ.202> initialize .JBREN for us
	MOVEM	t,.JBREN		;<KPJ.202> . . .
	MOVE	0,[acblk##+1,,1]	;<KPJ.201> put back ACs
	BLT	0,^O17			;<KPJ.201> . . .
	MOVE	0,acblk##+0		;<KPJ.201> . . .
					;<KPJ.202> stack pointer now points at
					;<KPJ.202> the LOWSEG stack, hopefully
	CALL	psiree			;<KPJ.202> turn on interrupts again
	CALL	badprg			;<KPJ.203> tell user about trauma
getx9:	return				;<KPJ.201> return from nasty experience
>;T10


T10,<	;This code is in the HIGH segment.

;Turn off all interrupts, while we have no HIGH segment.

takoff:	CALL	deque			;<KPJ.203> no data base interrupts...
	SETOM	psifak##		;<KPJ.206> don't allow interrupts
	return				;<KPJ.203> now then...

>;T10

T10,<	;This code is in the HIGH segment.	<KPJ.202>

;This routine make the PSI vector right in the LOW segment, when we have made
;a GETSEG to get a new HIGH segment.  The PSI vector points to locations in
;the HIGH segment, and those addresses must be put right, or else...

psibak:	MOVEI	t,trpout		;ho hum...
	MOVEM	t,qqqout##
	MOVEI	t,trpdat
	MOVEM	t,qqqdat##
	MOVEI	t,trpstp
	MOVEM	t,qqqstp##
	MOVEI	t,trptle
	MOVEM	t,qqqtle##
	MOVEI	t,trpcji##
	MOVEM	t,qqqcji##
	MOVEI	t,trppty##
	MOVEM	t,qqqpty##
	MOVEI	t,trpque
	MOVEM	t,qqqque##
	Fall	psiree			;<KPJ.203>

psiree:	SETZM	psifak##		;<KPJ.206> allow interrupts again
	return
>;T10

T10,<	;This code is in the HIGH segment.

;We come here from a GETX call (via GETXX) which changed to this segment from
;another using a GETSEG. This means that the JOBDAT area is in a mess. We must
;initialize it to a correct state, as well as a lot of other stuff.

segret:	MOVE	t,[-2,,.GTUPM]		;<KPJ.202> us
	GETTAB	t,			;<KPJ.202> get high segment start
	 MOVEI	t,evec-.JBHDA		;<KPJ.202> failed, try this (gulp!)
	HLRZ	t,t			;<KPJ.202> get origin
	CAIN	t,0			;<KPJ.202> no start address??
	 MOVEI	t,evec-.JBHDA		;<KPJ.202> failed, try this (gulp!)
;	ADDI	t,.JBHSA		;<KPJ.202> use word 0 (.JBHSA)
	MOVE	t,0(t)			;<KPJ.202> restore RH(.JBSA) from this
	HRRM	t,.JBSA			;<KPJ.202> . . .
	MOVE	t,myree			;<KPJ.202> put back REENTER address
	MOVEM	t,.JBREN		;<KPJ.202> . . .
	MOVE	0,[acblk##+1,,1]	;<KPJ.201> restore ACs
	BLT	0,^O17			;<KPJ.201> . . .
	MOVE	0,acblk##+0		;<KPJ.201> . . .
	MOVE	P,stackp##		;<KPJ.201> get an empty stack
	MOVEI	t,tercon##		;<KPJ.201> restore consumer
	MOVEM	t,consum##		;<KPJ.201> . . .
	MOVEI	t,terpro##		;<KPJ.201> restore producer
	MOVEM	t,produc##		;<KPJ.201> . . .
	CALL	matbak##		;<KPJ.231> restore match routines
	CALL	psibak			;<KPJ.202> restore interrupt vectors
	CALL	copslf			;<KPJ.210> remember segment name
	 CALL	errmsg##		;<KPJ.210> failed, tell user
	JRST	toploo##		;<KPJ.201> "return" to top loop
>;T10

T10,<
;We come here when a RUN command fails, but we succeed to load
;back our original high segment.  This means that a number of JOBDAT area
;variables are in an incorrect state.  Try to restore them, so we don't crash
;so often.

xxback:	PORTAL	.+1			;<KPJ.143> in case we are concealed
	MOVE	t,[-2,,.GTUPM]		;<KPJ.202> us
	GETTAB	t,			;<KPJ.202> get high segment start
	 MOVEI	t,evec-.JBHDA		;<KPJ.202> failed, try this (gulp!)
	HLRZ	t,t			;<KPJ.202> get origin
	CAIN	t,0			;<KPJ.202> no start address??
	 MOVEI	t,evec-.JBHDA		;<KPJ.202> failed, try this (gulp!)
;	ADDI	t,.JBHSA		;<KPJ.202> use word 0 (.JBHSA)
	MOVE	t,0(t)			;<KPJ.202> restore RH(.JBSA) from this
	HRRM	t,.JBSA			;<KPJ.143> . . .
	MOVE	t,myree			;<KPJ.202> get REENTER address
	MOVEM	t,.JBREN		;<KPJ.202>
	MOVE	0,[acblk##+1,,1]	;<KPJ.143> put back ACs
	BLT	0,^O17			;<KPJ.143> . . .
	MOVE	0,acblk##+0		;<KPJ.202> . . .

;We are now back in original high segment, and have to tell the user that the
;RUN command failed (we must open up I/O and so on, first, because the RUN UUO
;does kill off all open files etc).

	CALL	initty			;<KPJ.143> initialize terminal
	CALL	badprg			;<KPJ.203> say whe couldn't run prog
	rstreg				;<KPJ.143> restore ACs saved
	print	zrun99##		;<KPJ.143> "--- starting "
	CALL	prcinm			;<KPJ.143> display our own name
	print	zrun98##		;<KPJ.143> " ---"
	CALL	preol##			;<KPJ.143>
	CALL	toutpu			;<KPJ.143> 
	JRST	start##			;<KPJ.143> restart us
>;T10

T10,<
;+
;COPSLF		remember name of current high segment	<KPJ.210>
;accepts	RUNBLK/	GETSEG/RUN block
;		XPATH/	PATH. block
;returns	+1 failure, with
;			STR/	error message
;			XMYSLF/	-1
;			SAMNES/	-1
;		+2 success, with
;			XMYSLF/	GETSEG/RUN block
;			XMYPTH/	PATH. block
;			SAMNES/	=0  if high segment and program names differ
;				=-1 otherwise
;-

copslf:	MOVE	t,[runblk##,,xmyslf##]	;from,,to
	BLT	t,xmyslf##+3-1		;copy device, file name and extension
	MOVE	t,[-2,,.GTDEV]		;<KPJ.211> get segments device
	GETTAB	t,			;<KPJ.211> . . .
	 TRNA				;<KPJ.211> failed, use maybe-logical
	  MOVEM	t,xmyslf##+0		;<KPJ.211> now we have a physical one
	MOVE	t,[-2,,.GTPRG]		;<KPJ.211> get segment name
	GETTAB	t,			;<KPJ.211> . . .
	 TRNA				;<KPJ.211> failed, use defined one
	  MOVEM	t,xmyslf##+1		;<KPJ.211> now we have physical one
	SETZM	xmyslf##+3		;always zero
	MOVEI	t,xmypth##		;PATH. pointer
	MOVEM	t,xmyslf##+4		;. . .
	SETZM	xmypth##+0		;clear PATH. block
	SETZM	xmypth##+1		;. . .
	SETZM	xmyslf##+5		;no core assignment specified
	HLRZ	t,runblk##+4		;get PPN or PATH. pointer
	JUMPN	t,[			;PPN?
		MOVE	t,runblk##+4	;yes, copy PPN
		MOVEM	t,xmypth##+2	;. . .
		SETZM	xmypth##+3	;no SFDs
		JRST	copsl8]		;done, +2 return
	HRRZ	t2,runblk##+4		;<KPJ.211> no, get PATH. pointer
	ADDI	t2,2			;skip two first words
	MOVEI	t3,xmypth##+2		;ditto, target PATH. block
copsl1:	CAIN	t3,xmyend##		;target block full?
	 JRST[	MOVEI	str,zcopsl##	;yes, return error message
		SETOM	xmyslf##+0	;don't know segment name
		JRST	copsl9]		;give up
	MOVE	t,0(t2)			;copy a word
	MOVEM	t,0(t3)			;. . .
	JUMPE	t,copsl8		;end of list?
	ADDI	t2,1			;increment buffer pointers
	AOJA	t3,copsl1		;. . .
copsl8:	skpret				;+2 return means success
	SETZM	samnes##		;<KPJ.211> assume unequal
	HRROI	t,.GTRDV		;<KPJ.211> get "program run device"
	GETTAB	t,			;<KPJ.211> . . .
	 JRST	copsl9			;<KPJ.211> failed, give up
	CAME	t,xmyslf##+0		;<KPJ.211> same device?
	 JRST	copsl9			;<KPJ.211> no
	HRROI	t,.GTRFN		;<KPJ.211> get "program run file name"
	GETTAB	t,			;<KPJ.211> . . .
	 JRST	copsl9			;<KPJ.211> failed, give up
	CAME	t,xmyslf##+1		;<KPJ.211> same file name?
	 JRST	copsl9			;<KPJ.211> no
	HRROI	t,.GTRDI		;<KPJ.211> get "program run directory"
	GETTAB	t,			;<KPJ.211> . . .
	 JRST	copsl9			;<KPJ.211> failed, give up
	CAME	t,xmypth##+2		;<KPJ.211> same PPN?
	 JRST	copsl9			;<KPJ.211> no
	PUSH	P,gp2			;<KPJ.211> GP1 is destroyed by SFDP
	CALL	sfdp			;<KPJ.211> does monitor like SFDs?
	 JRST[	POP	P,gp2		;<KPJ.211> no, restore destroyed AC
		JRST	copsl7]		;<KPJ.211> same name
	MOVE	t4,gp2			;<KPJ.211> copy max #SFDs (n)
	POP	P,gp2			;<KPJ.211> restore destroyed AC
	MOVN	t4,t4			;<KPJ.211> -nn
	HRLZ	t4,t4			;<KPJ.211> -nn,,0
copsl6:	HRROI	t,.GTRS0(t4)		;<KPJ.211> get "program SFD name"
	GETTAB	t,			;<KPJ.211>
	 JRST	copsl9			;<KPJ.211> failed, give up
	CAME	t,xmypth##+3(t4)	;<KPJ.211> same?
	 JRST	copsl9			;<KPJ.211> no
	JUMPE	t,copsl7		;<KPJ.211> end of list? if so, equal
	AOJA	t4,copsl6		;<KPJ.211>
copsl7:	SETOM	samnes##		;<KPJ.211> equal
copsl9:	return
>;T10

REPEAT	0,<			;<KPJ.210>
T20,<					;run a program in a subfork
runx:: 	MOVSI	1,(GJ%OLD!GJ%SHT)	;we must get a JFN
	HRRO	2,gp1
	GTJFN%
	 ERJMP[	CALL	initty
		print	zrun01##	;Sorry, luser...
		CALL	jsyser##	;<KPJ.64>...system barfed
		CALL	preol##		;new line
		CALL	toutpu
		JRST	start##]
	MOVE	0,1		; save the JFN
	HLL	0,gp1		; ..and the offset
	HRLZI	1,run4ac
	HRRI	1,4
	BLT	1,15		; move code into the acs
	JRST	4		; go there

run4ac:	SETO	1,		; 4
	HRLZI	2,.FHSLF	; 5
	MOVE	3,[PM%CNT+1000]	; 6
	PMAP%			; 7	; unmap all pages
	HRRZ	1,0		; 10	; get back the jfn
	HRLI	1,.FHSLF	; 11
	GET%			; 12	; get the new file into memory
	MOVEI	1,.FHSLF	; 13
	HLRZ	2,0		; 14	; get back the offset
	SFRKV%			; 15	; start somewhere in entry vector
>;T20
>;End REPEAT 0

;+
T20,<
;RUNFRK		Run a program as a subfork:
;		create a subfork and start something in it
;accepts	GP1/	offset and addr of filename string
;returns	+1	if access to the program is denied
;		+2	when execution of the program is completed
;-

runfrk::			;*NOTE* no SAVE macro here please
	SETZ	gp2,			;no fork, by default
	CAIE	gp1,rnexec##		;is it Push to EXEC?
	 JRST	rnfrk1			;no, create new fork
	SKIPE	gp2,execfh##		;yes, do we have an EXEC fork?
	 JRST[	HRRZ	1,execfh##	;[KPJ.32] 0,,fork handle
		RFSTS%			;[KPJ.32] how is the fork?
		 ERJMP	rner01		;failed
		CAMN	1,[-1]		;<KPJ.124> no such fork?
		 JRST	.+1		;<KPJ.124> somebody killed it...
		JRST	rnfrk3]		;no problems, go start EXEC fork
	MOVSI	1,(CR%CAP)
	CFORK%				;no, create EXEC fork
	 ERJMP	rner01			;...failed, go say we cannot
	MOVEM	1,execfh##		;save EXEC fork handle
	JRST	rnfrk2			;go get program into fork

rnfrk1:	MOVSI	1,(CR%CAP)		;create fork for non-EXEC
	CFORK%
	 ERJMP	rner01			;...failed, go say we cannot

rnfrk2:	MOVEM	1,gp2			;save our fork handle
 	MOVSI	1,(GJ%OLD!GJ%SHT)	;get a handle on the program
	HRRO	2,gp1
	GTJFN%
	 ERJMP	rner01			;...failed, go say we cannot
	HRL	1,gp2
	GET%				;now load the program into that fork
	 ERJMP	rner01			;...failed, go say we cannot

rnfrk3:	CALL	reltty			;release TTY
	MOVEI	1,.FHSLF		;for this fork
	MOVSI	2,(1B<.TICCC>)		;only trap ^C now
	STIW%

	MOVE	1,gp2			;get fork handle
	HLRZ	2,gp1			;run offset
	SFRKV%				;start the program
	 ERJMP	rner01			;no, die

	WFORK%				;let's wait for the fork to finish
	 ERJMP	rner01			;...failed, go say we cannot

	CAME	1,execfh##		;EXEC fork?
	 JRST[	KFORK%			;no, kill it
		 ERCAL	rner03		;failed to kill fork, tough...
		JRST	.+1]

	CALL	initty			;restore terminal params
	AOS	0(P)
	RET			;no RETURN macro please
>;T20


;+
T20,<
;RNER03		say we could not kill fork and why
;-

rner03:	print	zrun03##		;cannot get rid of fork
	CALL	preol##
	print	zrun02##		;say reason is...
	CALL	jsyser##		;<KPJ.64>...whaterever it is
	CALL	preol##
	CALL	toutput			;output buffer
	RET
>;T20

;+
T20,<
;RNER01		(not documented)
;-

rner01:	print	zrun01##		;"Cannot run "
	HRRZ	str,gp1			;pointer to ASCIZ
	CALL	prstr##			;type file name
	CALL	preol##
	print	zrun02##		;"That's because system says:"
	CALL	jsyser##		;<KPJ.64> output latest JSYS error
	CALL	preol##

rnferr:	CALL	toutpu			;empty buffer
	JUMPN	gp2,[			;if there is any fork,
		MOVE	1,gp2		;get fork handle
		KFORK%			;slaughter it
		 ERCAL	rner03		;...failure, sigh
		JRST	.+1]
	RET				;failure, +1 return
>;T20






;+
;SLEEPT		sleep for some time
;accepts	GP1/	sleep time, in ms
;returns	+1 if input given
;		+2 if no input
;-

sleept::save	<gp1,t>

T10,<	HRLI	gp1,(HB.RTL!HB.RWJ)		;[TEQ] get wake-up bits
	HIBER	gp1,				; go to sleep
	 error	<sleept monito>			; error 
	SKPINL					; input given? +1 return
>;T10
T20,<	MOVEI	1,.FHSLF			;this fork
	MOVE	2,[1B<typchn>]
	AIC%					; activate channel 1
	MOVE	1,gp1
	DISMS%					; sleep for a while
	MOVEI	1,.FHSLF			;this fork
	MOVE	2,[1B<typchn>]
	DIC%
	MOVEI	1,.PRIIN
	SIBE%
	 CAIA					;input given, +1 return
>;T20
	  skpret
	return

T20,<
ttyint:	EXCH	1,lev2pc##
	TLO	1,(PC%USR)		;user mode
	EXCH	1,lev2pc##
	DEBRK%
>;T20





;+
T10,<
;RSET		reset routine
;		[BDQ] on Twenex don't reset, it just complicates things.
;-

rset::	RESET
	return
>;T10


;SLEEPN		sleep for some time
;accepts	GP1/	time, in seconds


sleepn::
T10,<	SLEEP	gp1,>
T20,<	MOVE	1,gp1			;<KPJ.46!BDQ> get sleep time in ms
	DISMS%
>;T20
	return


;+
;XIT		exit routine
;returns	starts at entry vector location 0 (never returns to caller)
;		(KOM login: logs out job)	<KPJ.55>
;-

xit::
T10,<	SETZM	sema##			;not critical any more, so clear
	CALL	qlogin			;[BCQ] are we logged in?
	 JRST	xit1			;<KPJ.217!BCQ> yes, just leave
	SKIPE	detflg##		;<KPJ.217> detached?
	 OUTSTR[ASCIZ !
.LOGOUT
.!]					;<KPJ.217> no, tell user we die now
	LOGOUT				;<KPJ.217> and die
xit1:	EXIT	1,			;exit quietly
>;T10
T20,<	CALL	toutpu			;force out TTY buffer
	HALTF%				;return to superior
>;T20
	JSP	5,mordor		;<KPJ.55> call special fascist code
	JRST	ree##			;restart
;-----------------------------------
;+
auslog::comhed	0,runarg##,killme,ccmark##,zzraus##	;logout [KPJ.15]
;-
				;<KPJ.136> *** No SAVE macros ***
killme:	CALL	deque		;dequeue all requests
	SETZM	lfcnt##		; clear line feed count
	CALL	tcbeg##		; terminal output
	print	zleaco##	;"Bye bye" message
	CALL	updbeg##	; start update
	CALL	updlse##	; update last seen entry count
	CALL	endpre##	; clear present list
	CALL	updend##	; end of update
	CALL	deque		; dequeue all pending requests
	print	zwelba##
	CALL	colwhi##
	CALL	preol##
T10,<				;<KPJ.172>
QZIF,<	CALL	costpr>		;<KPJ.172> inform about session charge
>;T10
	CALL	toutpu		;output old text
T10,<	CALL	kjob		;<KPJ.217> initialize logoff
	 JRST[	CALL	errmsg##;<KPJ.217> failed, tell user
		JRST	killm9]	;<KPJ.217> give up
	PUSH	P,gp1		;<KPJ.217> save address
>;T10
	CALL	leave##		;<KPJ.217> leave program
	CALL	reltty	;<KPJ.217> release terminal
T10,<	POP	P,gp1		;<KPJ.217> get back RUNBLK address
	CALL	runx		;<KPJ.217> call STD:LOGOUT.EXE
>;T10
T20,<	MOVE	t,selffl##	;<KPJ.217> personal flags
	Txne	t,logpfl	;<KPJ.217> disconnect after logout?
	 DTACH%			;<KPJ.217> no, detach first
	MOVNI	1,1		;<KPJ.217> this job
	LGOUT%			;<KPJ.217> logout
	ERJMP	.+1		;<KPJ.217> failed
	HRROI	1,zsorry##	;<KPJ.217> "Cannot logout. Solly!"
	PSOUT%			;<KPJ.217> . . .
	Tmsg	<- ?>		;<KPJ.217> display JSYS error message
	MOVEI	1,.PRIOUT	;<KPJ.217> to terminal
	HRLOI	2,.FHSLF	;<KPJ.217> our latest message
KL10,<	MOVEI	3,0>		;<KPJ.217> no length limit
KL10N,<	SETZ	3,>		;<KPJ.217> . . .
	ERSTR%			;<KPJ.217> display it
	 ERJMP[	Tmsg	<(ERSTR% failed 1)>
		JRST	.+2]	;<KPJ.217>
	 ERJMP[	Tmsg	<(ERSTR% failed 2)>
		JRST	.+1]	;<KPJ.217>
	JRST	evec		;<KPJ.217> restart
>;T20
T10,<
killm9:
>;T10
	return			;<KPJ.217>

;+
T10,<
;LOGTMP		generate TMPCOR file for LMENU		[KPJ.22]
;		it contains either
;		/SHORT			short menus
;		/NOSHORT
;		/DISCONNECT		disconnect after logout
;		/NODISCONNECT
;returns	+1 failed to write TMP:LME
;		+2 success
;-

logtmp::save	<consum##,nr,ch,chpt##>
	HRROI	t,.GTPTR		;this job,,program to run
	GETTAB	t,			;get the info
	 TRNA				;error, try to write TMP:LME anyway
	  JUMPE	t,logtm8		;<KPJ.210> no program, no TMP:LME, OK
	MOVSI	t,'lme'			;<KPJ.65!KPJ.54> file TMP:LME
	MOVEM	t,tmcnam##		;<KPJ.65> use that name
	CALL	tmcbeg##		;start of tempcore
	 JRST	logtm9			;<KPJ.65> no core for buffer
	MOVEI	ch,"/"			;<KPJ.54> start of switch
	CALL	putch			;<KPJ.54> output slash
	MOVE	t,selffl##		;get our personal flags
	MOVEI	str,[ASCIZ !no!]	;<KPJ.216>
	Txne	t,logpfl		;disconnect after logout?
	 CALL	prstr##			;<KPJ.216!KPJ.54> no, don't disconnect
	print[	ASCIZ !disconnect/!]	;<KPJ.61!KPJ.54> tell LMENU that
	MOVE	t,selffl##		;<KPJ.61> get my flags
	MOVEI	str,[ASCIZ !no!]	;<KPJ.216>
	Txnn	t,shopfl		;<KPJ.61> short menus?
	 CALL	prstr##			;<KPJ.216!KPJ.61> no, long
	print[	ASCIZ /short
/]					;<KPJ.61> tell LMENU, end with CRLF
	CALL	tmcend##		;end of TMPCOR
	 $skipa				;<KPJ.216> failed, +1 return
logtm8:   skpret			;<KPJ.216> success, +2 return
logtm9:	return
>;T10

;+
T10,<					;<KPJ.172>
QZIF,<					;<KPJ.172>
;COSTPR		output session charge	[KPJ.21]
;-

costpr:	print	zsessi##		;"Session cost: "
	SETZ	1,			;for self
	CHARGE	1,			;get charge cost in local currency
	HRROI	2,.GTQPP		;royalty
	GETTAB	2,			;get it
	 JRST[	print[	ASCIZ  !??.??!]	;<KPJ.61> we don't know, say so
		JRST	costp9]		;<KPJ.61> exit fast
	ADD	1,2			;add costs
	IDIVI	1,^D100			;make SEK
	MOVE	nr,1			;shuffle
	PUSH	P,2			;save .01's
	CALL	prnum##			;output number
	print	zzzdot##		;currency dot
	POP	P,nr			;get .01's
	CAIL	nr,^D100		;too large?
	 JRST[	print[	ASCIZ !??!]	;<KPJ.61> something went wrong
		JRST	costp9]		;<KPJ.61> indicate that
	CAIGE	nr,^D10			;just one digit?
	 JRST[	PUSH	P,nr		;<KPJ.61> save precious data
		MOVEI	ch,"0"		;[KPJ.37] yep, output leading zero
		CALL	putch		;[KPJ.37]
		POP	P,nr		;<KPJ.61> restore fraction
		JRST	.+1]		;[KPJ.37]
	 CALL	prnum##			;output number
costp9:	CALL	preol##			;<KPJ.61> looks nicer with a CRLF
	return
>;QZIF
>;T10
	


;+
;QLOGIN		check if logged in
;returns	+1 if logged in
;		+2 if not logged in
;-

qlogin::
T10,<	PJOB	t,>		;[SEE] get job number
T20,<	GJINF%>			;[KPJ.6] get job number
T10,<	MOVN	t,t		;[SEE] make JOBSTS understand job number
	JOBSTS	t,		;[SEE] get job status
	 error	<qlogin monito>	;[KPJ.41!SEE] "impossible..."
	TLNN	t,(JB.ULI)	;[SEE] are we logged in ? (+1 return)
>;T10
T20,<	SKIPN	1>		;[KPJ.6] are we logged in? (+1 return)
	 skpret			;[SEE] no, +2 return
	return			;[SEE] yes


;+
T10,<				;[KPJ.5] Tops-10 only
;PAGIN		page in or create a block of memory. [SEE]
;		if the requested area doesn't exist on disk, create it.
;accepts	GP1/	length, in pages
;		GP2/	first page number
;returns	+1 failure to create new page, 
;		   with T/ error code, one of:
;				PAGLE%	core limit exceeded
;				PAGNS%	no swap space left
;				PAGNX%	virtual limit is zero
;		+2 success
;-

pagin::	save	<gp1,gp2>
	MOVN	gp1,gp1			;make negative repeat count
	TLZ	gp2,(PA.GAF)		;[KPJ.37] swap in
	MOVE	t,[.PAGIO,,gp1]		;swap page
	PAGE.	t,			;
	 TRNA				;argh!
	  JRST	pagin8			;+2 return - success
	CAIN	t,PAGCI%		;[BCQ] page already in memory?
	 JRST	pagin8			;[BCQ] yes, just return
	CAIE	t,PAGME%		;no such page?
	 error	<pagin-2 monito>	;no, some other ghastly error
	MOVE	t,[.PAGCD,,gp1]		;ok, create them
	PAGE.	t,			; this can't fail
	 TRNA				;too bad SEE, it did any way...
	  JRST	pagin8			;page created, +2 return
	CAIE	t,PAGNX%		;<KPJ.65> virtual limit zero?
	 CAIN	t,PAGLE%		;<KPJ.65> or, no more core?
	  JRST	pagin9			;<KPJ.65> yes, +1 return
	CAIN	t,PAGNS%		;<KPJ.65> no swap space left?
	 JRST	pagin9			;<KPJ.65> yes, +1 return
	error	<pagin-1 monito>	;<KPJ.65> no, REAL error...

pagin8:	skpret				;+2 return (success)
pagin9:	return				; done
>;T10


;+
T10,<				;[KPJ.5] Tops-10 only
;PAGOUT		throw a block of memory out on the disk [SEE]
;accepts	GP1/	length, in pages
;		GP2/	first page number
;-

pagout::MOVN	gp1,gp1			;make negative repeat count
	TLO	gp2,(PA.GAF)		;page out
	MOVE	t,[.PAGIO,,gp1]		;swap in or out
	PAGE.	t,
	 error	<pagout monito>		;should not fail...
	return
>;T10


;+
T10,<				;[KPJ.5] Tops-10 only
;PAGDEL		delete a block of memory [SEE]
;accepts	GP1/	length, in pages
;		GP2/	first page number
;-

pagdel::MOVN	gp1,gp1			;make negative repeat count
	TLO	gp2,(PA.GAF)		;delete
	MOVE	t,[.PAGCD,,gp1]		;create or delete page
	PAGE.	t,
	 JRST[	CAIN	t,PAGME%	;no such page?
		 JRST	.+1		;ok, we got rid of it
		error <pagdel monito>]
	return
>;T10


;+
;PRCINM		write exact file spec. for this program <SEE>
;		if high segment name is not same as program name, show both
;-

prcinm::save	<ch,gp1,gp2>
T10,<	HRROI	gp1,.GTRDV		;<KPJ.210> get "run device"
	GETTAB	gp1,			;<KPJ.210> . . .
	 MOVE	gp1,[SIXBIT !??????!]	;<KPJ.210>
	CALL	prcin3			;write it
	MOVEI	ch,":"			;end with colon
	CALL	putch
	HRROI	gp1,.GTRFN		;<KPJ.210> get "run file name"
	GETTAB	gp1,			;<KPJ.210> . . .
	 MOVE	gp1,[SIXBIT !??????!]	;<KPJ.210>
	CALL	prcin3			;write it
	print[	ASCIZ !.exe!]		;<KPJ.121> assume .EXE extension
	MOVEI	ch,.CHLBR
	CALL	putch			;[KPJ.35]
	HRROI	gp1,.GTRDI		;<KPJ.210> get "run directory"
	GETTAB	gp1,			;<KPJ.210> . . .
	 JRST[	print[	ASCIZ !?,?!]	;<KPJ.210> unknown
		JRST	.+2]		;<KPJ.210>
	  CALL	prippn##		;if known, output it
	CALL	sfdp			;[KPJ.37] SFDs on this system?
	 JRST	prcin2			;[KPJ.37] no SFDs
	MOVN	gp2,gp2			;[KPJ.37] make a negative counter
	HRLZ	gp2,gp2			;[KPJ.37] -nn,,0
prcin1:	HRROI	gp1,.GTRS0(gp2)		;<KPJ.210> get SFD name
	GETTAB	gp1,			;<KPJ.210> . . .
	 MOVE	gp1,[SIXBIT !??????!]	;<KPJ.210> unknown
	JUMPE	gp1,prcin2		;<KPJ.210>
	MOVEI	ch,","			;get comma
	CALL	putch			;output it
	CALL	prcin3			;write SFD name
	AOBJN	gp2,prcin1		;loop for next SFD

prcin2:	MOVEI	ch,.CHRBR
	CALL	putch
	SKIPE	samnes##		;<KPJ.205> same program name?
	 JRST	prcin9			;<KPJ.205> yes, exit
	print[	ASCIZ ! + !]		;<KPJ.205>
	MOVE	gp1,xmyslf##+0		;<KPJ.210!KPJ.210> get segment device
	CALL	prcin3			;<KPJ.205> write it
	MOVEI	ch,":"			;<KPJ.205> end with colon
	CALL	putch			;<KPJ.205>
	MOVE	gp1,xmyslf##+1		;<KPJ.210!KPJ.205> segment file name
	CALL	prcin3			;<KPJ.205> write it
	MOVEI	ch,"."			;<KPJ.211> "." starts extension
	CALL	putch			;<KPJ.211>
	SKIPN	gp1,xmyslf##+2		;<KPJ.210> segment extension
	 MOVE	gp1,[SIXBIT !exe!]	;<KPJ.210> default is EXE
	CALL	prcin3			;<KPJ.210>
	MOVEI	ch,.CHLBR		;<KPJ.205>
	CALL	putch			;<KPJ.205>
	MOVE	gp1,xmypth##+2		;<KPJ.210> segment PPN
	CALL	prippn##		;<KPJ.205> write PPN
	CALL	sfdp			;<KPJ.205> monitor likes SFDs?
	 JRST	prcix2			;<KPJ.205> no, done
	MOVN	gp2,gp2			;<KPJ.205> make a negative counter
	HRLZ	gp2,gp2			;<KPJ.205> -nn,,0
prcix1:	SKIPN	gp1,xmypth##+3(gp2)	;<KPJ.210> get SFD name
	 JRST	prcix2			;<KPJ.210!KPJ.205> no more SFDs
	MOVEI	ch,","			;<KPJ.205> get comma
	CALL	putch			;<KPJ.205> output it
	CALL	prcin3			;<KPJ.205> write SFD name
	AOBJN	gp2,prcix1		;<KPJ.205> loop for next SFD

prcix2:	MOVEI	ch,.CHRBR		;<KPJ.205> end of PPN part
	CALL	putch			;<KPJ.205>
>;T10
T20,<	MOVEI	1,evec			;<KPJ.132> get entry vector address
	LSH	1,-9			;<KPJ.132> make page#
	HRLI	1,.FHSLF		;<KPJ.132> this fork
	RMAP%				;<KPJ.132> get page map
	HLRZ	1,1			;<KPJ.132> get handle
	CAIE	1,.FHSLF		;<KPJ.132> private page?
	 JRST[	MOVE	2,1		;<KPJ.132> no, shuffle
		HRROI	1,jfnsit##	;<KPJ.132> put result here
		SETZ	3,.CHNUL	;<KPJ.132> end on NUL
		JFNS%			;<KPJ.132> get file name
		ERJMP	.+1		;<KPJ.132> failed, do dirty way
		SETZ	2,.CHNUL	;<KPJ.132> get NUL
		IDPB	2,1		;<KPJ.132> make ASCIZ
		MOVEI	str,jfnsit##	;<KPJ.132> point at name buffer
		CALl	prstr##		;<KPJ.132> output name
		JRST	prcin9]		;<KPJ.132> done
	MOVE	gp1,[SIXBIT !kom:!]	; [BDQ] quick & dirty -- fix this later
	CALL	prcin3
	GETNM%
	SKIPN	gp1,1
	 MOVSI	gp1,'kom'
	CALL	prcin3
>;T20
prcin9:	return

;+
;PRCIN3		outputs sixbit word as ASCII
;accepts	GP1/	sixbit word
;-

prcin3::MOVE	t4,[POINT 6,gp1]	;<KPJ.47> point at source
	MOVE	t3,[POINT 6,t2]		;<KPJ.47> point at temp
	SETZ	t2,			;<KPJ.47> clear temporary word
	MOVEI	t,6			;<KPJ.47> max #chars in a word
prcin4:	ILDB	ch,t4			; no, get next character
	IDPB	ch,t3			;<KPJ.47> save copy
	ADDI	ch,"A"-'A'		; make it ASCII
	PUSH	P,t			;<KPJ.47> save counter
	CALL	putch			; write it
	POP	P,t			;<KPJ.47> restore counter
	CAME	t2,gp1			;<KPJ.47> written all of it?
	 SOJG	t,prcin4		;<KPJ.47> if more, continue
	return				; come here when done with word

;+
T10,<
;SFDP	test if SFDs exist on this system
;return	+1 if SFD feature not in this system, with GP2/ 0
;	+2 if SFDs enabled, with GP2/ max level of SFDs
;-

sfdp::	MOVE	gp2,[%FTSTR]		;<KPJ.37!KPJ.67> get feature info
	GETTAB	gp2,			;[KPJ.37]
;	 warn	<monito sfdp gettab ftstr>
	 SETZ	gp2,			;<KPJ.167!KPJ.41!KPJ.37> argh...
	TRNN	gp2,<F%SFD&777777>	;[KPJ.37] SFD feature enabled?
	 JRST[	SETZ	gp2,		;[KPJ.37] no, no SFDs
		JRST	sfdp9]		;
	MOVE	gp2,[%LDSFD]		;[KPJ.37] get max number of SFDs
	GETTAB	gp2,			;[KPJ.37]
	 TDZA	gp2,gp2			;<KPJ.245!KPJ.167!KPJ.37> argh...
	  skpret			;<KPJ.167>
sfdp9:	return
>;T10
;-----------------------------------
;KJOB		initialize Job Terminator	<KPJ.217>
;returns	+1 failed, STR/ error message
;		+2 success, GP1/ pointer to RUNBLK

T10,<
kjob:	MOVE	t,selffl##		;get our personal flags
	MOVEI	gp1,[EXP 'std   ','logout','exe   ',0,0,0]
					;STD:LOGOUT.EXE
	Txne	t,logpfl		;disconnect after logout ?
	 HRLI	gp1,1			;yes, /RUNOFFSET:1
	CALL	grrblk			;save name in RUNBLK
	 $skipa				;failed, +1 return
	   skpret			;success, +2 return
	return
>;T10
;-----------------------------------
T10,<	END	evec>
T20,<	END	evclen,,evec>
	PRINTX	?Error: missing END or macros screwed up in MONITO module
>	PRINTX	?Error: missing END or macros screwed up in MONITO module
>	PRINTX	?Error: missing END or macros screwed up in MONITO module
]	PRINTX	?Error: missing END or macros screwed up in MONITO module
]	PRINTX	?Error: missing END or macros screwed up in MONITO module
	PRINTX	<Aborting...>
	PASS2
	END
..and no more