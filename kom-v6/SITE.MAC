;1	Make TOPS-20 CENNAM be PRINTable (those stupid zero words should be
;	eliminated, really). Ditto for CENPRO.

	SEARCH	kommac
	PROLOG	(site)
site:!

;     Copyright (c) Swedish National Defense Research Institute
;	(c) QZ Computing Centre, 1984-08-20 06:48:52

;	D A T A   A R E A

;OPNCEN		FILOP. argument block

opncen::
T10,<	BLOCK	1		;0	.FOFNC	function code
	BLOCK	1		;1	.FOIOS	dump mode,physical device
	BLOCK	1		;2	.FODEV	device
	0,,0			;3	.FOBRH	no buffers
	0,,0			;4	.FONBRF	no buffers
	0,,cenfil		;5	.FOLEB	RENAME block,,ENTER block
	.PTPPN+1,,cenpat	;6	.FOPAT	length,,path block pointer
	BLOCK	1		;7	.FOPPN	PPN (returned here)
	opnlen==:.-opncen	;<KPJ.22> length of OPNCEN
>;T10
T20,<	BLOCK	1		;JFN
	BLOCK	1		;GTJFN% flags
	FLD(^D36,OF%BSZ)	;OPENF% flags: 36 bits bytes
	BLOCK	filmax/5+1	;file name
>; T20
T10,<
cenfil::0,,cenlen		;0	.RBCNT	0,,length
	0,,0			;1	.RBPPN	path pointer
	BLOCK	1		;2	.RBNAM	file name
	BLOCK	1		;3	.RBEXT	extension, etc
	BLOCK	1		;4	.RBPRV	protection, etc
	0			;5	.RBSIZ	file size (words)
cenlen==:.-cenfil		;#parameter words

cenpat::BLOCK	.PTPPN+1	;[SEE] path PPN of central file
>; T10

;	P R O G R A M   C O D E

	CODE

T20,<
DEFINE	bldwrd	(bit,pos)<
	.%word==.%word+<bit'B<pos>>>

	.%word==0

	bldwrd	(0,.TT33)		;TTY model 33
	bldwrd	(0,.TT35)		;TTY model 35
	bldwrd	(0,.TT37)		;TTY model 37
	bldwrd	(0,.TTEXE)		;Execuport
	bldwrd	(1,4)			;Datamedia ELITE 1520/1521
	bldwrd	(1,5)			;unspecified display terminal
	bldwrd	(1,6)			;Beehive B100
	bldwrd	(1,7)			;Volker Craig VC414
	bldwrd	(1,.TTDEF)		;System-Default (display?)
	bldwrd	(0,.TTIDL)		;Ideal
	bldwrd	(1,.TTV05)		;VT05
	bldwrd	(1,.TTV50)		;VT50
	bldwrd	(0,.TTL30)		;LA30
	bldwrd	(1,.TTG40)		;GT40
	bldwrd	(0,.TTL36)		;LA36
	bldwrd	(1,.TTV52)		;VT52
	bldwrd	(1,.TT100)		;VT100
	bldwrd	(0,.TTL38)		;LA38
	bldwrd	(0,.TT120)		;LA120
	bldwrd	(1,^D19)		;VC415
	bldwrd	(1,^D20)		;HP2648 
	bldwrd	(1,^D21)		;Teleray 1061
	bldwrd	(1,^D22)		;Datamedia Elite 2500
	bldwrd	(1,^D23)		;Visual 200
	bldwrd	(1,^D24)		;Volker Craig VC404
	bldwrd	(0,^D25)		;"Paper"
	bldwrd	(1,^D26)		;ADM3A
	bldwrd	(0,^D27)
	bldwrd	(0,^D28)
	bldwrd	(1,^D29)		;<KPJ.7> Facit Twist
	bldwrd	(1,^D30)	;[Vic.25] Sun Console
	bldwrd	(0,^D31)
	bldwrd	(0,^D32)
	bldwrd	(0,^D33)
	bldwrd	(0,^D34)
	bldwrd	(1,^D35)		;VT125
	bldwrd	(1,^D36)		;VK100 - GIGI

trmtps::EXP	.%word
	.%word==0			;<ZOT.23>
	bldwrd	(1,.TT102-^D36)		;<ZOT.23> VT102
	bldwrd	(1,.TTH19-^D36)		;<KPJ.24> H19
	bldwrd	(1,.TT131-^D36)		;<ZOT.23> VT131
	bldwrd	(1,.TT200-^D36)		;<ZOT.23> VT200 series
	EXP	.%word			;<ZOT.23>
>;T20

T10,<
cendev::xcedev				;<KPJ.17> data base device
IFE	<.-cendev>,<
IF1,<	PRINTX	?XCEDEV incorrect>
	0>
>;T10
cennam::xcenam				;<KPJ.2> data base name
IFE	<.-cennam>,<
IF1,<	PRINTX	?XCENAM incorrect>
	0>
T20,<	BLOCK	7>		;patch area
T10,<
cenext::xceext				;<KPJ.17> data base extension
IFE	<.-cenext>,<
IF1,<	PRINTX	?XCEEXT incorrect>
	0>
>;T10
cenpro::				;central file protection
T10,<	BYTE	(9)477>
T20,<IFE ftjsys,<ASCIZ !P776464!> ; without KOM% jsys
     IFN ftjsys,<ASCIZ !P770202!> ; with KOM% jsys
>;T20


ztmpco::xtmpko			;<KPJ.4!KPJ.4>	Tops-10: TMPCOR name to use
					;	TOPS-20: temporary file to use

;+
T10,<					;<KPJ.20>
FOAIF,<					;<KPJ.21>
;FOAPPN		check if FOA PPN
;returns	+1 if FOA PPN
;		+2 if not FOA PPN
;-

foappn::MOVE	t,selfpp##		;get PPN
	CAME	t,[barppn]		;FOA PPN ?
	 skpret				;no
	return
>;FOAIF
>;T10
	END
..and no more