;Freja::Qs:<Kom.6.Macro>Entcon.Mac.13 870421-2252,KPJ-Jaakkola
;25	WHERE is a Bottoms-10 UUO. Rename WHERE routineto WHORE.
;Oden::DSKG:ENTCON.MAC<62,7777,MAC> 1986-11-11 04:25:19, Edit by KPJ @ H.HOLE
;24	Handle +2 return from BEGLIN.
;Oden::DSKG:ENTCON.MAC<62,7777,MAC> 1986-08-29 03:48:41, Edit by KPJ @ 1SKEDE
;23	ENTCON should not increment LINPOS.
;Freja::Qs:<Kom.6.Macro>Entcon.Mac.3 860805-1411,KPJ-Jaakkola
;22	Don't finish entry until tested.
;Oden::DSKG:ENTCON.MAC<62,7777,MAC> 1986-02-14 19:27:01, Edit by KPJ
;21	Sanitized code.
;Oden::DSKD:ENTCON.MAC<62,7777,MAC> 1985-11-04 15:48:59, Edit by KPJ
;20	Ignore command character if so specified.
;Oden::DSKD:ENTCON.MAC<62,7777,MAC> 1985-10-01 01:29:09, Edit by KPJ
;17	Introduced PROLOG macro.
;Oden::DSKD:ENTCON.MAC<62,7777,MAC> 1985-09-06 09:21:25, Edit by KPJ
;16	Expunged KPJHAT variable from source.
;Oden::DSKD:ENTCON.MAC<62,7777,MAC> 1985-08-01 18:42:04, Edit by KPJ @ DECGR
;15	Forgot GENELI in edit #14.
;Oden::DSKD:ENTCON.MAC<62,7777,MAC> 1985-07-26 xx:xx:xx, Edit by KPJ @ ORANGE
;14	Prepared GENELI for "string" zero word deletion.
;Oden::DSKD:ENTCON.MAC<62,7777,MAC> 1985-06-27 08:22:25, Edit by KPJ @ L89
;13	Use CMDCHR for command character.
;Oden::DSKD:ENTCON.MAC<62,7777,MAC> 1985-06-25 13:55:59, Edit by KPJ @ KYLA
;12	Fixed problem with ACR in commands during entry writing.
;Oden::DSKD:ENTCON.MAC[62,7777] 1985-01-30 11:45:54, Edit by KPJ @ L89
;11	Got rid of CHKEXP.
;Oden::DSKD:ENTCON.MAC[62,7777] 1985-01-16 03:22:22, Edit by KPJ @ GRAV
;10	Put back possibility to enter commands at end-of-page prompt ("Please
;	press return" prompt).
;Oden::DSKD:ENTCON.MAC[62,7777] 1985-01-03 17:19:07, Edit by KPJ @ L89
;7	Moved language dependent texts to TEXTER.
;Oden::DSKD:ENTCON.MAC[62,7777] 1984-12-11 06:17:04, Edit by KPJ @ NADJA
;6	Make ^Z end an entry in all positions of a line.
;Oden::DSKD:ENTCON.MAC[62,7777] 1984-11-22 23:24:34, Edit by K.JAAKKOLA
;5	Allow max number of characters in lines.
;Oden::DSKD:ENTCON.MAC[62,7777] 1984-10-12 13:30:47, Edit by K.JAAKKOLA
;4	Global never used outside this module: CHKEXP. Local.
;	Inserted COPYRIGHT macro.
;Oden::DSKD:ENTCON.MAC[62,7777] 1984-10-04 04:48:14, Edit by K.JAAKKOLA
;3	Cleaned up code somewhat for future changes.
;Oden::Dskd:Entcon.Mac[62,7777] 1984-05-14 16:47:29, Edit by KPJ Jaakkola
;2	Merged T20 and T10 versions. Updated copyright notice.
;Oden::Dsk:Entcon.Mac[62,657] 1984, Edit by T Tholerus
;1	Get rid of Martin NILsson LISP-like code
;Oden::DSK:ENTCON.MAC[62,657] 198x, Edit by Martin NILsson
;0.5	Various entry hacking.

        SEARCH  kommac
	PROLOG	(entcon)

;     Copyright (c) Swedish National Defense Research Institute
;	copyright <QZ Computer Centre, 1984> ;[KPJ.4]

;       D A T A   A R E A


cmdpfl::0				;<KPJ.20> ignore-commands-p
wriflg::0				;write flag

	CODE

;	C O M M A N D  T A B L E S
;+
reouen::comhed	0,noarg##,routen,ccroen##,zraehl##  ;reassign output to entry
delay::	comhed	0,adelay,<[RET]>,ccdely##,zdlyhl##  ;delayed command
;-

;+
; ECBEG  --  start entry makeing
; changes QUEST, MENUQ, HDMENU and CONSUM
;-

ecbeg::	MOVE	t,consum##		;save old consumer
	MOVEM	t,oldcon##
	MOVEI	t,entcon		;make entry
	MOVEM	t,consum##
	MOVEI	t,promt			;text input
	MOVEM	t,quest##
	MOVE	t,txttab##		;entry menu
	MOVEM	t,menuq##
	MOVE	t,txttab##+1		;entry commands
	MOVEM	t,hdmenu##
	SETOM	wriflg			;writing
	return





;+
;ENTCON		consume characters and make an entry of them
;accepts	CH/	char
;-

entcon:	save	<str>
;<KPJ.23> CALL	inclpo##		;increase line position
	MOVE	str,linptr##		; get current line
	CAIN	ch,.CHESC		;[KPJ.3] ESC?
	 JRST[	SKIPE	cmdpfl		;<KPJ.20> ignore commands?
		 JRST	entco9		;<KPJ.20> yes
		CALL	cleacr##	;<KPJ.12> switch off ACR
		CALL	makcom		;[KPJ.3] yes, make command
		CALL	setacr##	;[KPJ.3] set ACR
		JRST	entco9]		;[KPJ.3] end of command 
	CAIN	ch,.CHCRT		;[KPJ.3] not ESC, is it CR ?
	 JRST	entco9			;[KPJ.3] yes, ignore
	CAIE	ch,.CHLFD		;[KPJ.3] LF ?
	 CAIN	ch,.CHFFD		;[KPJ.3] no, FF ?
	  JRST[	CALL	qready		;[KPJ.3] end of line, entry ready ?
		JRST	entco9]		;[KPJ.3]
	CAIN	ch,.CHCNZ		;[KPJ.3] ^Z ?
	 JRST[	CALL	chkadd		;<KPJ.3> yes, check if to add entry
		JRST	entco9]		;[KPJ.3] ready
	CALL	pchent			;put char in entry
entco9:	return





;+
;CHKADD		check if to add entry
;-

chkadd::SKIPE	1(str)			;last line empty ?
	 CALL	geneli			;<KPJ.22!KPJ.6> no, get next line
	CALL	gremlin##		;remove last line
	CALL	adentr##		;do command "Enter (it)"
	 TRNA				;<KPJ.22> no
	  JRST[	CALL	finent##	;<KPJ.22> back to main command level
		AOS	ccaden##	;<KPJ.22> one more entry added
		JRST	.+1]		;<KPJ.22>
	return





;+
; MAKCOM  --  make a command
; returns last char in CH
;-

makcom:	save	<consum##,quest##>
	CALL	tcbeg##			; output to terminal
	setmem	quest##,prher##		; command prompter
	CALL	rdcomm##		; read command
	 nop				; empty reply
	CALL	topcomm##		; do command
	SKIPL	intflg##		;[KPJ.3] entry deleted?
	 CALL	whore##			;<KPJ.25!KPJ.3> say where we are
makco9:	branch	tcend##			; end of terminal output





;+
;PCHENT		put character in entry
;accepts	LINPTR/	line
;		CH/	character
;-

pchent:	save	<str>
	SKIPN	str,linptr##		;get current line
	 JRST	pchen9			;not defined
	MOVE	t,1(str)		;get character count
	CAILE	t,ormarg		;[KPJ.5] is there room ?
	 CALL	geneli			;no, get a new line
	IDPB	ch,-1(str)		;save the character
	AOS	1(str)			;increase character count
pchen9:	return





;+
;GENELI		get new line
;returns	+1, with STR/	  new line
;			 LINPTR/  new line
;-

geneli:	save	<tp,bp,ch,pwrflg##,chpt##>
	MOVE	str,linptr##		;get number of chars
	MOVE	t,selffl##		;[KPJ.11] get personal flags
	Txne	t,nbrpfl		;[KPJ.11] break?
	 JRST[	SKIPN	0(str)		;[NIL.0] yes, line empty?
		 JRST	genel2		;[NIL.0] yes, remove it
		JRST	.+1]
	ADDI	str,2			;point at ASCIZ string
	CALL	mkbp##			;[TTQ.1] Make byte pointer
	MOVEM	bp,chpt##		;    Save it
	CALL	gshort##		;[TTQ.1] Get first char
	SKIPE	cmdpfl			;<KPJ.20> suppress commands?
	 JRST	genel2			;<KPJ.20> yes, line is data
	CAIN	ch,cmdchr		;<KPJ.13!KPJ.3!KPJ.1> command?
	 JRST	genel1			;[KPJ.3]
	SKIPL	ncoflg##		;[KPJ.1!3] command?
	 CALL	parscm			;[NIL.0] yes
	  JRST	genel2			;[NIL.0] no
	CALL	gremli##		;[NIL.0] remove line
	CALL	beglin##		;restore blank line
	 TRNA				;<KPJ.24> failed, give up
	  CALL	execcm			;<NIL.0> execute the command
	CALL	whore##			;<KPJ.25!NIL.0> say where we are
	JRST	genel9
genel1:	CALL	nexsho##		;[TTQ.1] Bypass character
	CALL	gremli##		;[TTQ.1] Remove command line
	CALL	beglin##		;[TTQ.1] Start new line
	 TRNA				;<KPJ.24> failed, give up
	  CALL	makcom			;<TTQ.1> make command
	JRST	genel9			;[TTQ.1] command done

genel2:	CALL	beglin##		;start new line
	 nop				;<KPJ.24> failed (what? me worry? :-)
genel9: CALL	setacr##		;set ACR
	return




;+
;PARSCM		check if command
;accepts	CHPT/	command line
;		CH/	first char	[KPJ.1]
;returns
;		TP/	command line
;		+1 if not a command
;		+2 if command
;-

parscm::save	<silflg##,errfl##,ch,consum##>
	SETOM	silflg##		; be silent
	CALL	gshort##		;[KPJ.10] get first char
	CALL	qalpha##		; alphanumeric ?
	 JRST	parsc9			; no, not command
	MOVE	tp,alltab##+1		; get all commands
	CALL	commat##		; look for a match
	 TRNA				;+1 return: not a command
	  TRNA				;+2 return: command
	   JRST	parsc9			;+3 return: not a command
	MOVE	tp,agrval##		; get command
	HRRZ	tp,(tp)			; get command head
	SKIPE	(tp)			; sub command ?
	 JRST	parsc9			; yes, dont do it
	CALL	tcbeg##			; output to terminal
	CALL	colcya##		; restore colour
	CALL	argcom##		; get command argument
	CALL	tcend##			; end of terminal output
	SKIPGE	errfl##			;[KPJ.3] any error?
	 JRST	parsc9			;[KPJ.3] yes, return
	CALL	gshort##		; get last char
	CAIN	ch,.CHNUL		;[KPJ.3] end of line ?
	 skpret				;[NIL.0] yes, command
parsc9:	return				;[NIL.0]



;+
; EXECCM  --  execute a command
; gets command line in TP
;-

execcm::save	<consum##>
	CALL	tcbeg##		;[NIL.0] output to terminal
	CALL	execom##	;[NIL.0] execute command
	branch	tcend##		;[NIL.0] end of terminal output


;+
; QREADY  --  check if entry ready
; gets current line in STR
;-

qready:	save	<str>
	SKIPL	useflg##	;input from user?
	 JRST	qread8		;no
	MOVE	t,selffl##		;[KPJ.11] get personal flags
	Txnn	t,nbrpfl		;[KPJ.11] yes, break?
	 JRST	qread8			; no
	SKIPN	1(str)		; line empty ?
	 CALL	finent##	; finish entry
qread8:	CALL	geneli		; start new line
	return





;+
; PROMT  --  promt for an entry input
; gets current entry in ENTRY,
; line to prompt with in LINPTR
;-

promt:	SKIPGE	pwrflg##		;prompter written ?
	 JRST	promt9
	CALL	preol##			;new line
	CALL	prcurr##		;print current line
promt9:	return





;+
; TXTHLP  --  give help for text input
;-

txthlp:	save	<str>
	MOVE	t,selffl##		;get personal flags
	MOVEI	str,zhltxt##		;"end entry eith two CRs" is default
	Txne	t,nbrpfl		; check if expert
	 MOVEI	str,zhlexp##		;yes, "end entry with CTRL/Z"
	CALL	prstr##			;say it
	branch	preol##

;+
; ECEND  --  stop making entry
;-

ecend::	return



;+
; ROUTEN  --  reassign output to the entry
;-

routen:	save	<consum##,quest##,hdmenu##,menuq##,ncoflg##,papflg##>
	CALL	ecbeg			;start entry
	MOVEI	t,prmenu##		;command promter
	MOVEM	t,quest##
	MOVEI	t,zmenu##		;menu question
	MOVEM	t,menuq##
	SETOM	ncoflg##		;no command interpret
	SETOM	papflg##		;no display output
	CALL	topcom##		;do top level command
	CALL	ecend			;end of entry
	return


;+
; ADELAY  --  argument for delay command
;-

adelay:	save	<ch>
	SKIPGE	silflg##		;[KPJ.3] silent?
	 JRST[	SETOM	errfl##		; set error flag
		JRST	adela9]
	MOVEI	ch,.CHESC		;[KPJ.3] get command char (ESC)
adela1:	CALL	pchent			; put char in entry
	ILDB	ch,chpt##		; get char
	JUMPN	ch,adela1		; end of string ?
	CALL	geneli			; start new line
adela9:	return

	END
..and no more