;37	Moved magical numbers from MONITO and PTYKOM code here.
;Oden::DSKD:KOMMAC.MAC[62,7777,MAC] 1985-02-26 07:33:29, Edit by KPJ @ L89
;36	Additional BUGFIX parameter, which is generated if bugfix flag is OFF.
;Oden::DSKD:KOMMAC.MAC[62,7777,MAC] 1985-02-20 17:13:25, Edit by KPJ @ L89
;35	New symbols .CHOBR and .CHCBR for "[" and "]" characters.
;	Symbols for PPN beginning and ending character. Moved macros from
;	module MONITO here. Eliminated macros XTRMOP, TRMOPE, TRMOPS, TRMOPR.
;	which were used in MONITO. Macro XGTLCH was never used, deleted.
;Oden::DSKD:KOMMAC.MAC[62,7777,MAC] 1985-02-20 13:42:05, Edit by KPJ @ L89
;34	Moved macros from MONFIL module: XFILOP, XLOOK, XAPPEN, XCENOP,
;	XUPDAT, XLOKUP, XCLOSE, XDELET, XIND, XOUTD, XUSET, XUSETI, XUSETO
;Oden::DSKD:KOMMAC.MAC[62,7777,MAC] 1985-02-13 17:59:16, Edit by KPJ @ L89
;33	New symbol .CHQUO for quote character
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-02-04 15:48:49, Edit by KPJ @ L89
;32	New macro ZUBJLN to define "subject:" string hacking for DISPLA.
;DSKD:KOMMAC.MAC[62,7777] 1985-02-04 15:28:54, Edit by KPJ @ L89
;31	New macro DEFLANG which defines all the language text strings.
;	New symbols of form ".<language>", e.g. .SWE, for the language codes.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-02-04 15:24:33, Edit by KPJ @ L89
;30	New macro BUGFIX.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-01-25 14:32:27, Edit by KPJ @ L89
;27	New macro FTBUG to display values of bug fix switches.
;	Bug switch FTBG00: governs LOGIN /NAME:-problems with "{|}" characters
;	(defined in feature file, used in MONTMP)
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-01-17 12:22:34, Edit by KPJ @ L89
;26	Added standard-like symbols for parentheses.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-01-09 20:26:24, Edit by KPJ @ GRAV
;25	LH of DIRNMA word of TEXT objects reserved for "number of lines in
;	entry" (zero means no information exists (we always have at least the
;	"Subject:" line in entries, so this is no restriction).
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-01-07 23:27:42, Edit by KPJ @ L89
;24	New personal flags COMMENT UNMARKS NOTICE (bit 20, default ON) and
;	LOGIN QUESTION (bit 35, default OFF)
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-01-07 19:24:45, Edit by KPJ @ L89
;23	SYMPFL personal flag (bit 20) deleted, since never used.
;	Added "<" and ">" as .CHLBR and .CHRBR symbols.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1985-01-03 16:52:04, Edit by KPJ @ L89
;22	Moved some magical numbers here from EDIT module.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-12-01 02:25:21, Edit by KPJ @ NADJA
;21	Define CALLRET macro.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-11-29 07:22:13, Edit by KPJ @ UPSALA
;20	Introduced bit 16 of personal flag word to mean "deferred commands"
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-11-27 12:34:58, Edit by KPJ @ NADJA
;17	Introduced various magical numbers from PTYKOM module.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-11-27 03:54:08, Edit by KPJ @ NADJA
;16	Introduced bit 17 of personal flag word to mean "complete headings"
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-11-15 08:29:14, Edit by K.JAAKKOLA
;15	Moved data base sizes to the TnnFEA.MAC, where they really belong
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-11-12 13:24:56, Edit by K.JAAKKOLA
;14	Introduced the FALL macro (used to fall through)
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-11-02 09:19:12, Edit by K.JAAKKOLA
;13	Moved various magical numbers here from ZAPOBJ, CHAPGS, CREPER,
;	MONITO.
;	(For future ease of re-hacking things)
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-10-12 14:41:04, Edit by K.JAAKKOLA
;12	Included a (c) notice macro, in the UUOSYM style.
;Oden::DSKD:KOMMAC.MAC[62,7777] 1984-10-09 23:09:17, Edit by K.JAAKKOLA
;11	Minor inconsistencies noted at TOPS-20.
;Oden::Dskd:Kommac.Mac[62,7777] 1984-10-03 22:16:00, Edit by K.Jaakkola
;10	Made KOMMAC display what feature switches it sets. NRFLAG now
;	is number of implemented flags (used in LISPER). Defined standard
;	names for characters. Defined BUG macro.
;Oden::Dskd:Kommac.Mac[62,7777] 1984-10-03 21:46:24, Edit by K.Jaakkola
;7	Prepared to get rid of useless "string" macro, by creating an offset
;	to be used when hacking the "strings" (variable KPJHAT==1 now)
;Oden::Dskd:Kommac.Mac[62,7777] 1984-09-25 03:36:50, Edit by K.Jaakkola
;6	Get rid of useless ridiculous macros in DDT at least.
;Oden::Dskg:Kommac.Mac[62,7777] 1984-07-30 08:04:13, Edit by KPJ Jaakkola
;5	Moved the feature switches to FEATURE.MAC for easier hacking.
;Oden::Dskg:Kommac.Mac[62,7777] 1984-07-10 09:16:49, Edit by KPJ Jaakkola
;4	Implemented MAXINF,MAXTEX,MAXDIR,MAXLNK,MAXMAR variables. Need only
;	change here in the future to change data base size...
;Oden::Dskg:Kommac.Mac[62,7777] 1984-05-23 06:28:19, Edit by KPJ Jaakkola
;3	Implemented door bell flag
;Oden::Dskg:Kommac.Mac[62,7777] 1984-05-23 02:40:55, Edit by KPJ Jaakkola
;2	Outer inner margin changed from 77 to 80. Sizes of data bases too.
;	Updated copyright notice.
;Oden::Dsk:Kommac.Mac, started at 1980-06-22, 3 a.m., Edit by T Tholerus
;1	complete rewriting
;Oden::Dsk:Kommac.Mac, started at 1977-06-21, 2 a.m., Edit by T Tholerus
;0	first version

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;						;
;		K	O	M		;
;						;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

	UNIVER	kommac
	.DIREC	.NOBIN
	SALL

;	Copyright (c) QZ Computer Center, 1984, 1985, 1986.
;	Copyright (c) Swedish National Defense Research Institute

;-----------------------------------
IF1,<				;Some definitions for pass 1
DEFINE	fthack	(ftname)<
IFNDEF	ftname,<PRINTX %*WARNING* Feature switch ftname undefined, zeroed
		ftname==0>
>;fthack

DEFINE	ftbool	(ftname,ftz000,ftz001,ftz002)<
	fthack	ftname
IFE	ftname,<PRINTX	ftname	=0	ftz000:	ftz001>
IFN	ftname,<PRINTX	ftname	<>0	ftz000:	ftz002>
>;ftbool
				;<KPJ.160>
DEFINE	ftbug	(ftname,helptext)<
IFNDEF	ftname,<ftname==0>
IFE	ftname,<PRINTX	Bugfix: ftname = 0 =  NO: helptext>
IFN	ftname,<PRINTX	Bugfix: ftname <>0 = YES: helptext>
>;ftbug

DEFINE	ftswit	(ftname,fttext,ftz001)<
	fthack	ftname
	ftz002==0
	ftz003==0
IRP	<ftz001>,<
		IFE	ftname-ftz003,<
			PRINTX	ftname		fttext:	ftz001
			ftz002==-1
			STOPI>
		ftz003==ftz003+1>
IFE	ftz002,<PRINTX	?***ERROR*** Feature switch ftname out of bounds
		PASS2
		END>
>;ftswit
;-----------------------------------
>;IF1

	.kl10==0		;KL10/KS10
	.ki10==1		;KI10
	.ka10==2		;KA10
	.pdp6==3		;PDP-6

IFNDEF	ftcpu,<
	PRINTX	%*WARNING* FTCPU undefined, assuming KL10
	ftcpu==.kl10		;<KPJ.217> default
>;ftcpu

DEFINE	KL10	<IFE	<ftcpu-.kl10>>
DEFINE	KL10N	<IFN	<ftcpu-.kl10>>
DEFINE	KI10	<IFE	<ftcpu-.ki10>>
DEFINE	KI10N	<IFN	<ftcpu-.ki10>>
DEFINE	KA10	<IFE	<ftcpu-.ka10>>
DEFINE	KA10N	<IFN	<ftcpu-.ka10>>
DEFINE	PDP6	<IFE	<ftcpu-.pdp6>>
DEFINE	PDP6N	<IFN	<ftcpu-.pdp6>>

	PRINTX
IFDEF	ftcpu,<			;<KPJ.217>
IFE	<ftcpu+1>,<PRINTX	CPU type:	unknown>
IFN	<ftcpu+1>,<ftswit	FTCPU,<CPU type>,<KL10/KS10,KI10,KA10,PDP6>>
>;ftcpu
IFNDEF	ftcpu,<ftswit	FTCPU,<CPU type>,<KL10/KS10,KI10,KA10,PDP6>>
PDP6,<	PRINTX	%*WARNING* PDP-6 code not yet supported>
	ftswit	FTTWX,<OS version>,<Tops-10,TOPS-20,Tenex,ITS>

	.b10==0			;<KPJ.217> Bottoms-10
	.twx==1			;<KPJ.217> Twenex
	.tnx==2			;<KPJ.217> Tenex
	.its==3			;<KPJ.217> ITS
IFL	<fttwx-.b10>,<		;<KPJ.217>
		PRINTX	?*ERROR* FTTWX is out of bounds (negative), T10 used
		fttwx==.b10>	;<KPJ.217>
IFG	<fttwx-.its>,<		;<KPJ.217>
		PRINTX	?*ERROR* FTTWX is out of bounds (too large), T10 used
		fttwx==.b10>

DEFINE	T10	<IFE	<fttwx-.b10>> ;<KPJ.217> Bottoms-10
DEFINE	T20	<IFE	<fttwx-.twx>> ;<KPJ.217> Twenex
DEFINE	TNX	<IFE	<fttwx-.tnx>> ;<KPJ.217> TENEX
DEFINE	ITS	<IFE	<fttwx-.its>> ;<KPJ.217> ITS

TNX,<	PRINTX	%*WARNING* TENEX code not yet supported>
ITS,<	PRINTX	%*WARNING* ITS code not yet supported>

IF1,<
T20,<	ftbool	FTJSYS,<Use KOM% JSYS for OPENF%>,<No>,<Yes>
	ftbool	FTJSY2,<Use GTKOM% JSYS for GTJFN%>,<No>,<Yes>
>;T20
	ftbool	FTQZ,<QZ hacks>,<Yes>,<No>		;old style
DEFINE	QZIF	<IFE	ftqz>				;<KPJ.160>
DEFINE	NQZIF	<IFN	ftqz>				;<KPJ.160>
	ftbool	FTFOA,<FOA hacks>,<Yes>,<No>		;old style
DEFINE	FOAIF	<IFE	ftfoa>				;<KPJ.160>
DEFINE	NFOAIF	<IFN	ftfoa>				;<KPJ.160>
	ftbool	FTRUN,<CALL commands>,<Yes>,<No>	;old style
DEFINE	RUNIF	<IFE	ftrun>				;<KPJ.160>
DEFINE	NRUNIF	<IFN	ftrun>				;<KPJ.160>
	ftswit	FTLAN,<Language to use>,<SWE,ENG,NOR,GER,FRE>
	ftswit	FTDB,<Data base to use>,<SWE,ENG,GER,NOR,QOM>
	ftbool	FTPHON,<Swedish PTT text phones>,<No>,<Yes>
						;;<KPJ.47>
				;<KPJ.65>
IFNDEF	pasmin,<PRINTX	%*WARNING* PASMIN was undefined - set to zero
		pasmin==0>
IFL	pasmin,<
	PRINTX %PASMIN .LT. 0	- not defined - setting PASMIN to 0
	pasmin==0
>
IFE	pasmin,<
	PRINTX PASMIN  =  0	Password length testing code:	No>
IFG	pasmin,<
	PRINTX PASMIN  .GT. 0	Password length testing code:	Yes>

T10,<	ftbool	FTPRIV,<FFA: has special access>,<No>,<Yes>>
T10,<	ftbool	FTLOG,<Error logging>,<No>,<Yes>>	;;[KPJ.46]
	<ftbool	FTVIEW,<Viewdata support>,<No>,<Yes>>	;;<KPJ.61>
	<ftbool	FTCOMP,<COMPUTE command>,<No>,<Yes>>	;;<KPJ.76>
T10,<					;<KPJ.120>
QZIF,<RUNIF,<ftbool FTQOM,<'Call QOM' command>,<No>,<Yes>>> ;<KPJ.160!KPJ.120>
IFNDEF	xtmpko,<
	PRINTX	?***ERROR*** XTMPKO macro undefined - no TMPCOR file
	DEFINE	xtmpko<0>>
>;T10
IFNDEF	nameid,<
	PRINTX	?***ERROR*** NAMEID macro undefined - no data base name
	DEFINE	nameid<0>
>;nameid
T20,<
IFNDEF	fzexec,<
	PRINTX	%*WARNING* FZEXEC macro undefined - using DEFAULT-EXEC:
	DEFINE	fzexec<DEFAULT-EXEC:>>
>;T20
	ftbool	FTPTYM,<PTY mode included>,<No>,<Yes>		;;<KPJ.127>
	ftbool	FTUSER,<CREATE USER is privileged>,<No>,<Yes>
	ftbool	FTCONF,<CREATE CONF is privileged>,<No>,<Yes>
	ftbool	FTSUBJ,<Conference type 'Subject'>,<No>,<Yes>	;;<KPJ.132>
	ftbool	FTENQ,<ENQ/DEQ flushed>,<No>,<Yes>		;;<KPJ.135>
	ftbool	FTANON,<Anonymity supported>,<No>,<Yes>		;;<KPJ.137>
	ftbool	FTPHYS,<Use /PHYSICAL>,<No>,<Yes>		;;<KPJ.145>
T20,<	fthack	FTSAVE
IFL	ftsave,<PRINTX	FTSAVE .LT. 0	use SSAVE% to dump memory>
IFE	ftsave,<PRINTX	FTSAVE .EQ. 0	use internal routines to dump memory>
IFG	ftsave,<PRINTX	FTSAVE .GT. 0	use SAVE% to dump memory>
>;T20
	ftbool	FTEMPL,<EMPLOYEE support>,<No>,<Yes>		;;<KPJ.155>
	ftbool	FTEMP2,<EMP file in data base>,<No>,<Yes>	;;<KPJ.156>
	ftbool	FTREMO,<No admin.mode on remote TTY>,<No>,<Yes>	;;<KPJ.203>
	ftbool	FTCACH,<Output cache>,<No>,<Yes>		;;<KPJ.212>
IFL	ftcach,<PRINTX	FTCACH	.LT. 0	Input cache:	Yes, and separate.>
IFE	ftcach,<PRINTX	FTCACH	= 0	Input cache:	No>
IFG	ftcach,<PRINTX	FTCACH	.GT. 0	Input cache:	Yes, same as output.>
	ftbool	FTHALF,<Half-duplex support>,<No>,<Yes>		;;<KPJ.221>
QZIF,<	ftbool	FTNTWK,<Network address>,<No>,<Yes>		;;<KPJ.227>
IFN	ftntwk,<			;<KPJ.227>
IFNDEF	netwrk,<			;<KPJ.227>
	PRINTX	%*WARNING* NETWRK macro undefined - no network name
	DEFINE	netwrk	<>>		;<KPJ.227>
>;ftntwk
>;QZIF
	ftbool	FTCOUR,<Get encouragement>,<No>,<Yes>		;;<KPJ.231>

IFN	ftempl,<IFE	ftemp2,< ;<KPJ.156>
	PRINTX	?KOMMAC: FTEMP2 must be set non-zero when FTEMPL<>0
	ftemp2==1
>;ftemp2=0
>;ftempl
T10,<
IFNDEF	xcedev,<						;<KPJ.145>
	PRINTX	%*WARNING* XCEDEV macro undefined - using KOM:
	DEFINE	xcedev<SIXBIT	!kom!>>				;<KPJ.145>
IFNDEF	xceext,<						;<KPJ.145>
	PRINTX	%*WARNING* XCEEXT macro undefined - using null extension
	DEFINE	xceext<0>>					;<KPJ.145>
>;T10

;Tops-10 bug fixes:

T10,<	ftbug	FTBG00,<Convert Swedish {|} to [\] for LOGIN/NAME:-switch>
QZIF,<	ftbug	FTBG01,<AMIS handles max  40 characters>>
QZIF,<	ftbug	FTBG02,<TTY QUIET to not echo LF>>
	ftbug	FTBG03,<No protection for TECO in TMP:EDT>
>;T10
	
;TOPS-20 bug fixes:

T20,<
;	 (none so far)
>;T20
>;IF1
;-----------------------------------

;+
	hisegm==^O400K			;<KPJ.114> Start of high segment
				;<KPJ.111!KPJ.104>
				;<KPJ.111> no entry in main module
				;<KPJ.111> load address for main
				;<KPJ.104>
DEFINE	terror	(uck,foo,bar)<
PRINTX ?Attempt to use opcode UCK FOO,BAR
>;End DEFINE  terror
