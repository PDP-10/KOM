mee:	BLOCK	1		;<KPJ.157> MEE file	Conference
num:	BLOCK	1		;<KPJ.157> NUM file	Number
lnk:	BLOCK	1		;<KPJ.157> LNK file	Link
pre:	BLOCK	1		;<KPJ.157> PRE file	Present
loc:	BLOCK	1		;<KPJ.157> LOC file	Local
lac:	BLOCK	1		;<KPJ.157> LAC file	Act local
mar:	BLOCK	1		;<KPJ.157> MAR file	Mark
IFN	ftemp2,<		;<KPJ.156!KPJ.155>
ena:	BLOCK	1		;<KPJ.157> ENA file	E-name
emp:	BLOCK	1		;<KPJ.157> EMP file	Employee
>;ftemp2
sub:	BLOCK	1		;<KPJ.157> SUB file	Subconf
sac:	BLOCK	1		;<KPJ.157> SAC file	Act subconf
maxmet==.-1			;<KPJ.157> maximum number of files
	RELOC

	opgsz1==^D24			;[KPJ.13]default screen size
	opgsz2==^D60			;[KPJ.13]default paper size
IFN	ftphon,<			;[KPJ.41]
	opgsz3==^D12			;[KPJ.13]#lines text phone (300 baud..)
	opgsz4==^D32			;[KPJ.41] automagic newline around here
>;ftphon

	maxlen==^D1000			;<KPJ.22> max #lines in an entry

	firblk=	2		;first block
	firwrd=	1		;first word in block
;+
QZIF,<					;<KPJ.160>
T10,<					;<KPJ.160>
IFNDEF	CHARGE,<OPDEF CHARGE[CALLI -2]>	;<KPJ.160> return job charge (in |re)
IFNDEF	.GTQPP,<.GTQPP==-4>		;<KPJ.160> special program-prod charge
IFNDEF	.GTQJS,<.GTQJS==-6>		;<KPJ.160> special job status word
IFNDEF	QJ.COM,<QJ.COM==1B4>		;<KPJ.160> job logged in via KOM
IFNDEF	.TOQUI,<.TOQUI==^O1766>		;<KPJ.169> TTY QUIET mode to NO ECHO.
>;T10
>;QZIF
	;Link types:

	typrec=	1B35		; type receiver
	typkno=	1B34		; type info copy
	typcom=	1B33		; type comment
	typsct==1B32		; type secret
	typsub==1B31		; type subject
	typexc==1B30		; type extra copy
	typmem==1B29		; type member
;-
	chabla==77		; normalized blank char
	ctylet==1		; letter
	ctydig==2		; digit
	ctyalf==ctylet+ctydig	; alphanumeric
	ctyspe==4		; special char
	ctyctl==10		; control char, typed as ^X
	ctyunp==20		; unprintable control char
	ctysti==40+ctyspe	; sticky special char

	maxinf==1		;  2 INFO records

	newbsi=	1		; new buffer size
	metbsi=	4		; met buffer size
	infbsi=	2		; inf buffer size
	texbsi=	2		; tex buffer size
	dirbsi=	2		; dir buffer size
	pnabsi=	20		; pna buffer size
	perbsi=	1		; per buffer size
	pacbsi=	5		; pac buffer size
	mnabsi=	20		; MNA buffer size

	meebsi=	1		; mee buffer size
IFNDEF	maxmee,<numbsi=0>
IFDEF	maxmee,<numbsi=	<1_maxmee>/^D31+1> ; num buffer size

	lnkbsi=	5		; lnk buffer size
	prebsi=	2		; pre buffer size
	locbsi=	1		; loc buffer size
	lacbsi=	5		; lac buffer size
	marbsi=	1		; mar buffer size
IFN	ftemp2,<		;<KPJ.156!KPJ.155>
	enabsi=	40		; ena buffer size
	empbsi=	1		; emp buffer size
>;ftemp2
	subbsi=	1		; sub buffer size
	sacbsi=	^D10		; sac buffer size

	blksiz==^O200		; block size, one disk block
	blsize==blksiz-firwrd	; net block size
	blkssi==7		; block shift size
	infsiz==blsize		; INF record size
	fresiz==1000		; size of free area
	stksiz==1000		; stack size
IFN	ftlog,<			;<KPJ.50> error logging enabled?
T20,<	progid==10*ftdb+ftlan>	;<KPJ.50> yes, make program id
>;ftlog
T10,<	pthlen==8>			;PATH. block size

;+
;PUTCH		put a character in a buffer
;accepts	CH/	character
;-
DEFINE	putch	<@consum##>		;<KPJ.174>

DEFINE	$SKIPA	(foo,bar<,>)<
IFIDN	<bar>,<,>,<			;;second argument omitted
	IFB	<foo>,<			;;first omitted, too?
		KL10,<TRNA>		;;yes
		KL10N,<SKIPA>>
	IFNB	<foo>,<SKIPA	foo>>
IFDIF	<bar>,<,>,<			;;second argument given
	SKIPA	foo,bar>
>;DEFINE

DEFINE	$SETZ	(ac,foo)<
IFB	<foo>,<
	KL10,<MOVEI	ac,>
	KL10N,<SETZ	ac,>>
IFNB	<foo>,<
	..setz==foo				;;peel off angle brackets
.IFN	..setz,ABSOLUTE,<SETZ	ac,foo>		;;relocatable stuff
.IF	..setz,ABSOLUTE,<
	IFN	<foo>,<SETZ	ac,foo>
	IFE	<foo>,<
		KL10,<MOVEI	ac,foo>
		KL10N,<SETZ	ac,foo>>>
	PURGE	..setz
>>;$SETZ

DEFINE	$CRLF<
T10,<	OUTSTR[	BYTE (7) .CHCRT,.CHLFD,.CHNUL]>
T20,<	HRROI	1,[BYTE (7) .CHCRT,.CHLFD,.CHNUL]
	PSOUT%
>;T20
>;$CRLF

DEFINE	$DMOVM	(foo,bar)<
KL10,<	DMOVEM	foo,bar>
KL10N,<	MOVEM	foo,bar
	MOVEM	<foo+1>&^O17,bar+1
>;KL10N
>;$DMOVM
					;<KPJ.234>
DEFINE	CCOC(X0,X1,X2,X3,X4,X5,X6,X7,X8,X9,X10,X11,X12,X13,X14,X15,X16,X17)<
BYTE (2) .CC'X0,.CC'X1,.CC'X2,.CC'X3,.CC'X4,.CC'X5,.CC'X6,.CC'X7,.CC'X8,
	 .CC'X9,.CC'X10,.CC'X11,.CC'X12,.CC'X13,.CC'X14,.CC'X15,.CC'X16,.CC'X17
>;CCOC

DEFINE	$DMOVE	(foo,bar)<
KL10,<	DMOVE	foo,bar>
KL10N,<	MOVE	foo,bar
	MOVE	<foo+1>&^O17,bar+1
>;KL10N
>;$DMOVE

DEFINE	$MOVX	(ac,foo)<
	..movx==foo				;;evaluate expression
.IFN	..movx,ABSOLUTE,<MOVE	ac,[foo]>	;;relocatable stuff
.IF	..movx,ABSOLUTE,<
	..move==0				;;not generated yet
IFE	<..movx>,<	..move==1		;;SETZ group?
	$Setz	ac,>
IFE	..move,<IFE	<..movx>B53,<..move==1	;;MOVEI group?
	MOVEI	ac,foo>>
IFE	..move,<IFE	<..movx>B17,<..move==1	;;MOVSI group?
	MOVSI	ac,(foo)>>
IFE	..move,<IFE	<<..movx>B53-<0,,-1>>,<	..move==1 ;;<KPJ.230>
	HRROI	ac,foo>>			;;HRROI	group?
IFE	..move,<IFE	<<..movx>B17-<-1,,0>>,<	..move==1 ;;<KPJ.230>
	HRLOI	ac,(foo-^O777777)>>		;;HRLOI group?
IFE	..move,<				;;not generated yet?
	MOVE	ac,[foo]			;;if so, give up
>
	PURGE	..move
>>;$MOVX

DEFINE	$Dmovi	(foo,bar,bletch)<
KL10,<	DMOVE	foo,[EXP <bar>,<bletch>]>
KL10N,<	$Movx	foo,<bar>
	$Movx	<foo+1>&^O17,<bletch>
>;KL10N
>;$DMOVI

DEFINE	$Exit<
T10,<	EXIT	1,>
T20,<	HALTF%>
>;$EXIT

DEFINE	$psout	(foo)<
T10,<	OUTSTR	foo>
T20,<	HRROI	1,foo
	PSOUT%
>;T20
>;$PSOUT

DEFINE	nop	(foo,bar)<
IFNB	<foo>,<PRINTX	?NOP macro called with AC field>
IFNB	<bar>,<PRINTX	?NOP macro called with address field>
KL10,<	TRN	0,0>			;;<KPJ.174> no-operation
KL10N,<	JFCL	0,0>			;;<KPJ.174> no-operation
>;nop

	OPDEF	CALL[	PUSHJ	P,]	;recursive call
	OPDEF	RET[	POPJ	P,]	;recursive return
	OPDEF	CALLRET[JRST	]	;CALL + RET
	OPDEF	PJRST[	JRST	]	;<KPJ.217> Bottoms-10 types love this
	.NODDT	callret,pjrst		;<KPJ.217>

;NOTE:	To change the ENCRYPT and DECRYPT macros, ny previous data base must
;	be changed as well (so in real life, you can only change this when
;	you have no previous data base).

DEFINE	encrypt	(foo,bar)<
IFNB	<foo>,<	PRINTX	?ENCRYPT macro called with an AC field>
IFNB	<bar>,<	PRINTX	?ENCRYPT macro called with an address field>
	XORI	ch,"x"			;;<KPJ.131>
>;encrypt

DEFINE	decrypt	(foo,bar)<
IFNB	<foo>,<	PRINTX	?DECRYPT macro called with an AC field>
IFNB	<bar>,<	PRINTX	?DECRYPT macro called with an address field>
	XORI	ch,"x"			;;<KPJ.131>
>;decrypt

