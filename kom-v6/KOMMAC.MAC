;	M A C R O   D E F I N I T I O N S


;+
;BUGFIX macro is used to fix or alleviate external software bugs, e.g. in
;monitor, or system programs.
;-
				;[KPJ.30!KPJ.36]
				;<KPJ.160> shutup
DEFINE	bugfix	(flag,descr,oncode,offcod)<
IFNDEF	flag,<flag==0>
IFE	flag,<offcod>
IFN	flag,<oncode>
>;DEFINE

;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;These macros are for saving and restoring stuff on the stack:
;	SAVE	<list>		saves the entities from "list" on stack
;	RESTORE	var		restores one item from stack
;	RSTREG			restores everything stored
;	RETURN			restores everything and returns
;	SKPRET			adds +1 to return address
;	BRANCH	foo		restores everything and JRSTs to foo
;Following symbols are used to manage the mechanism:
;	TTQc		a help macro to create a temporary name
;	TTQnnn		a temporary name
;

DEFINE	TTQc(a,b)<a'b'>			;concatenation operator

	TTQsav==0			;initialize save number
				;save values
				;for each value do
				;	push it
				;	increase save number
				;	save the value
DEFINE	save	(vals)<
IRP	vals,<
	PUSH	P,vals
	TTQsav==TTQsav+1
	TTQc(TTQ,\TTQsav)==vals>
>;save

				;restore value
				;restore it
				;decrease save number
DEFINE	restore	(val)<
	POP	P,val
	TTQsav==TTQsav-1
>;restore
				;add one to return addr 
DEFINE	skpret	<
	AOS	-TTQsav(P)
>;skpret

				;restore stuff from stack
				;if anything on stack...
				;...then restore it
DEFINE	rstreg	<
IFN	TTQsav,<
	restore	TTQc(TTQ,\TTQsav)
	rstreg>
>;rstreg
				;restore stack and return
				;restore it all
				;and then return
DEFINE	return	<
	rstreg
	RET
>;return
				;restore registers and go
				;restore all regs
				; and then JRST
DEFINE	branch	(loc)<
	rstreg
	JRST	loc
>;branch
;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
				;[KPJ.14] fall through macro
DEFINE	fall	(foo)<
IF2 <IFN <.-<foo>>,<PRINTX ?***ERROR*** Cannot FALL into routine "foo">>>
				;test if flag on
				;flag on ?
				;yes
DEFINE	ifon	(flg,adr)<
	SKIPGE	flg
	 JRST	adr
>;ifon
				;test if flag off
				;flag off ?
				;  yes
DEFINE	ifoff	(flg,adr)<
	SKIPL	flg
	 JRST	adr
>;ifoff
				;if ch = x then go to lab
				;check if ch = x
				;yes, go to lab
DEFINE	ifeq	(x,lab)<
	CAIN	ch,x
	 JRST	lab
>;ifeq
				;if not ch = x then go to lab
				;check if ch = x
				;no, go to lab
DEFINE	ifneq	(x,lab)<
	CAIE	ch,x
	 JRST	lab
>;ifneq
				;set memory
				;get argument
				; mem := arg
DEFINE	setmem	(mem,arg)<
	MOVEI	t,arg
	MOVEM	t,mem
>;setmem

DEFINE	fromto	(from,to)<	;; move from from to to
	MOVE	t,from		;; get argument
	MOVEM	t,to>		;; save argument

DEFINE	call1	(reg,fun,arg)<	;; call with one argument
	MOVEI	reg,arg		;; get argument
	CALL	fun>		;; call function

DEFINE	table	(sta,com,str)<	;; command table element
	XWD	sta,.+1		;; status and pointer to table element
	XWD	str,com>	;; command name and command


;MAKPOI	used to be a global routine in CREPER module. It was somewhat
;useless to have a one-instruction subroutine, so it is now a macro.
;MAKPOI		make an object pointer
;accepts	GP1/	file number
;		NR/	record number
;returns	NR/	object pointer
;-

DEFINE	makpoi	<DPB	gp1,[POINT 9,nr,8]>	; save file number

; Some useful routines stolen from AMIS to decrement a
; bytepointer, much faster than ADJPB./JEQ
;(Only for 7-bit bytes. /KPJ)

DEFINE	DecrBP	(ac)<
	ADD	ac,[^O70000,,0]
	SKIPG	ac
	 SUB	ac,[^O430000,,1]
>;DecrBP

	sn==	1B35			;normal status
	sa==	1B29!sn			;administrator status

DEFINE	endtab	<0>		;end of command table

				; command header
DEFINE	comhed	(qfn,afn,cfn,cc,htx)<
	0			;; no sub table
	qfn			;; command condition
	afn			;; command argument
	cfn			;; command code
	cc			;; command count
	htx			;; help text
>;comhed

;Format of TABLE tables:

	LOC	0		;<KPJ.75>
	BLOCK	1		;<KPJ.230> 0	pointer to menu string start
codcon:!BLOCK	1		;<KPJ.230> 1	condition code (or 0)
codarg:!BLOCK	1		;2	argument code
codcom:!BLOCK	1		;3	command code
codcnt:!BLOCK	1		;4	command count
codhlp:!BLOCK	1		;5	help text
	RELOC
				;start from 0
				;define language#
				;increment language#
DEFINE	deflang	(foo)<
	..lang==0
IRP	foo,<	.'foo==..lang
		..lang==..lang+1>
>;deflang
	deflang	(<swe,eng,nor,ger,fre>)
T10,<RUNIF,<	QZIF,<	.qom==.fre>>>
	PURGE	deflang,..lang
				;<KPJ.103> output an ASCIZ text string
				;point at it
				;output it
DEFINE	print	(ztx)<
	MOVEI	str,ztx
	CALL	prstr##
>;print

;+
;*NOTE*	There is code which "knows" the WARN macro generates just one word.
;	The code skips over the WARN macro. Beware.
;-

DEFINE	warn	(foo,bar)<
	BUG(CHK,<foo>,<bar>)
>;define


;+
;*NOTE*	There is code which "knows" the BUG macro generates just one word.
;	The code skips over the BUG macro. Beware.
;-

DEFINE	bug	(typ,foo,bar)<
CALL[	CALL	bug'typ'##
	..foo==0			;;compute length of ASCIZ in bytes
IRPC	<foo>,<..foo==..foo+1>		;;. . .
	..foo==<..foo/5>+1		;;convert to words, including NUL
	..bar==1			;;length of the BUG entry so far
IRP	<bar>,<..bar==..bar+1>		;;include any add'l data
	..foo,,..bar			;;tell BUG handler about length
	[ASCIZ	!foo!]			;;length,,address
IRP	<bar>,<	bar>			;;any add'l data
IFDIF	<typ>,<HLT>,<RET>		;;we return if not BUGHLT'ing
	]
>;bug


T20,<	infwid==^D262143>		;<BDQ> "infinite terminal width"

;+
;*NOTE*	There is code which "knows" the ERROR macro generates just one word.
;	The code skips over the ERROR macro. Beware.
;-

DEFINE	error	(foo,bar)<BUG(HLT,<foo>,<bar>)>

				; META record:
DEFINE	meta	(mod,max)<
	BYTE	(9)met(27)mod	;; record number
	mod'SIZ			;; record size
	max			;; maximum number
	BLSIZE/mod'SIZ		;; number of records per block
	0			;; number of records
	0			;; number of created records
	0			;; number of read accesses
	0			;; number of write accesses
	.metnr			;; start of file
.metnr==.metnr+<<max-1>/<blsize/mod'SIZ>>+1 ;; get end of file
	mod'BSI			;; buffer size
>;DEFINE meta

	; central file buffer
DEFINE	buffer	(mod)<
	0			;;<KPJ.205!KPJ.123> (now unused)
	0			;; read accesses
	0			;; sum of read accesses
	0			;; write accesses
	0			;; sum of write accesses
	IOWD	mod'BSI*blksiz,mod'ARE	;; i/o block, dump mode
	0			;; end word
	0			;; update version number
	0			;; written flag
	mod'BSI			;; buffer size
	0			;; current block number
	mod'ARE			;; buffer area
>;DEFINE buffer

				;buffert area
DEFINE	bufare	(mod)<
mod'ARE:BLOCK	mod'BSI*blksiz
>;DEFINE bufare

;+++++++++++++++++++++++++++++++++++ START OF DEFSPE M A C R O S
				;give conference help
				;output help text
				;CRLF
DEFINE	defque	(foo,bar)<
	foo,,[	PUSH	P,str
		CALL	meehlp##
		print	bar
		CALL	preol##
		POP	P,str
		JRST	prher##]
>;defque
;+++++++++++++++++++++++++++++++++++ END OF DEFSPE M A C R O S
;+++++++++++++++++++++++++++++++++++ CMPMAC macros
IFN	ftcomp,<		;<KPJ.105>

;	C O M P U T E   C O N S T A N T S

	tt=	t+1			;temporary register
	cp=	tp			;cell pointer
	sem=	str			;semantic symbol pointer
	typ=	bfp			;type of value
	val=	nr			;value, semantic symbol
	arg=	gp2			;rest of argument list
	rp=	bp			;right priority


;+
;	C O M P U T E   R E C O R D S


	LOC	0
celtyp:!BLOCK	1			;+0	cell type
celval:!BLOCK	1			;+1	cell value
celsiz:!				;+2
	RELOC


	LOC	0
symcel:!BLOCK	celsiz			;+0 symbol cell
symnam:!BLOCK	2			;+3 symbol name
symsiz:!				;+5
	RELOC


	LOC	0
semnam:!BLOCK	2			;+0 symbol name
semord:!BLOCK	1			;+2 semantic order
sempar:!BLOCK	1			;+3 parse function
semval:!BLOCK	1			;+4 value function
sempri:!BLOCK	1			;+5 print function
semsiz:!
	RELOC

	LOC	0
strcel:!BLOCK	celsiz			;+0 structure cell
strnex:!BLOCK	celsiz			;+3 pointer to next structure
strsiz:!				;+6
	RELOC

	zelmax==^O4000		;<KPJ.177> max #cells		       (COMPUT)
	zelsiz==zelmax*strsiz-1	;<KPJ.177> cell area for COMPUT stack  (COMPUT)

	LOC	0
stacel:!BLOCK	celsiz			;+0 contents of cell
stapoi:!BLOCK	1			;+3 pointer to cell
stanex:!BLOCK	1			;+4 pointer to rest of argument list
stasiz:!				;+5
	RELOC
;-
>;ftcomp
	END
>
IF1,<	PRINTX	?You forgot a broket somewhere...>
	END
..and no more␀␀␀␀