T20,<				;Buffer control block
		;  +==+=+=======================+==========================+
.BFADR==0	;  !vr!i!                       !address of current buffer !
		;  +--+-+-----------------------+--------------------------+
.BFPTR==1	;  !                 byte pointer to data                  !
		;  +-------------------------------------------------------+
.BFCTR==2	;  !                     byte counter                      !
		;  +=======================================================+
>;T20

	noftto==8		;[TEQ] number of TTY output buffers
	noftti==2		;[TEQ] number of TTY input buffers

T10,<
;	I/O channels (T10)

	ttycha==	 1	;I/O channel for controlling terminal
	ificha==	 2	;input channel for file
	oficha==	 3	;output channel for file
	logcha==	 4	;output channel for log file
	cencha==	 5	;I/O channel for data base
