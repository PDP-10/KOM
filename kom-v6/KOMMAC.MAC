;	ENTER/LOOKUP BLOCK

T10,<	LOC	0
.RBCNT:	BLOCK	1			;length
.RBPPN:	BLOCK	1			;path pointer
.RBNAM:	BLOCK	1			;file name in SIXBIT
.RBEXT:	BLOCK	1			;extension in SIXBIT
.RBPRV:	BLOCK	1			;protection etc.
.RBSIZ:	BLOCK	1			;file size (words)
entblk:					;size of ENTER/LOOKUP block
	RELOC
>;T10

;	FILOP. BLOCK

T10,<	LOC	0
.FOFNC:	BLOCK	1			;flags, channel, and function code
.FOIOS:	BLOCK	1			;I/O mode
.FODEV:	BLOCK	1			;device (SIXBIT)
.FOBRH:	BLOCK	1			;buffer ring header pointers
.FONBF:	BLOCK	1			;number of buffer needed
.FOLEB:	BLOCK	1			;RENAME block,,LOOKUP/ENTER block
.FOPAT:	BLOCK	1			;pointer to PATH. block
.FOPPN:	BLOCK	1			;PPN
filblk:					;size
	RELOC
>;T10

;	HOMEBREW BLOCK

T20,<	LOC	0
.hmjfn:	BLOCK	1		;+0	JFN of file
.hmgtj:	BLOCK	1		;+1	GTJFN% flags
.hmbsz:	BLOCK	1		;+2	OPENF% flags
.hmnam:	BLOCK	<filmax+8>/5+1	;+3	file name in ASCIZ
	.hmmax==.-.hmjfn	;size
	RELOC
>;T20

