DEFINE	code	<RELOC	hisegm>		;<KPJ.104>
	
T10,<	SEARCH	UUOSYM(UUO:UUOSYM),MACTEN(UNV:MACTEN)
	OPDEF	XHLLI[	HLLI]		;<KPJ.57> used in extended addressing
	.NODDT	XHLLI			;<KPJ.57> don't tell DDT about it

	;Macros to handle field masks:		<KPJ.52>
;-----------------------------------
					;Compute width of mask, i.e. length
					;of leftmost string of ones:
DEFINE	WID	(mask)<<^L<-<<mask>_<^L<mask>>>-1>>>

					;Compute position of mask, 
					;i.e. bit position of rightmost one
					;in mask:
DEFINE	POS	(mask)<<^L<<mask>&<-<mask>>>>>

					;Construct byte pointer to mask:
DEFINE	POINTR	(loc,mask)<<POINT WID(mask),loc,POS(mask)>>

					;Put right-justified value into field
					;specified by mask:
DEFINE	FLD	(val,msk)<<<<val>B<POS(msk)>>&<msk>>>
;-----------------------------------
					;<KPJ.53> things used by .NOUT
					;Note: AC1 *must* be defined as either
					;====  .PRIOUT or be a byte pointer
	.PRIOUT==:^O101			;primary output (.NOUT uses PUTCH)
	.CTTRM==:^O777777		;controlling terminal
	NO%MAG==:1B0			;output magnitude
	NO%SGN==:1B1			;output sign
	NO%LFL==:1B2			;leading filler
	NO%ZRO==:1B3			;fill with zeroes
	NO%OOV==:1B4			;output on column overflow
	NO%AST==:1B5			;output asterisks on overflow
	NO%COL==:^O<177>B17		;number of columns to use
	NO%RDX==:^O777777		;radix
;-----------------------------------
					;<KPJ.52> masks for version word:
	VI%WHO==7B2			;Customer edit code
	VI%MAJ==^O<777>B11		;Major version number
	VI%MIN==^O<77>B17		;Minor version/update
	VI%EDN==^O<777777>B35		;Edit number

