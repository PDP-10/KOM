					;<KPJ.165> range check symbol
DEFINE	Range	(symbol,lowval,hival,routine,code)<
IFL	<symbol-lowval>,<
	PRINTX	?'routine': symbol less than lowval
	BUG(HLT,<Compilation error: ?'routine': symbol less than lowval>)
>
IFGE	<symbol-lowval>,<
IFG	<symbol-hival>,<
	PRINTX	?'routine': symbol greater than hival
	BUG(HLT,<Compilation error: ?'routine': symbol greater than hival>)
>
IFLE	<symbol-hival>,<
	code
>>
>;DEFINE Range

;+
				;Define a personal flag bit
				;reversed: set bit in LOGIPF
DEFINE	flagga	(name,bit,rev)<
	name'PFL==1B'bit
	nrflag==nrflag+1
IFNB	<rev>,<	logipf==logipf!name'PFL>
>;flagga

	nrflag==0
	logipf==0		;reverse logic handler (0="0=off",1="0=on")

;	*************************
;	*	  NOTE		*
;	*	  ====		*
;	* Re-compile module NEW *	Also need to update CHATAB
;	* when you change some- *	to be able to set, reset and inform
;	* thing with the perso- *	about the flag.
;	* nal flags!		*
;	*************************
;				;###### PERSONAL FLAGS ######
;				;bit  0
;				;  .
;				;(unused)
;				;  .
				;bit  4
IFN	ftcach,<
	flagga	mat,5		;bit  5 Name cache		<KPJ.212>
>;ftcach
	flagga	new,6,reversed	;bit  6 News control		<KPJ.204>
	flagga	bec,7,reversed	;bit  7	MEMBER implies JOIN	<KPJ.162>
	flagga	qux,8,reversed	;bit  8	obey QUIT command	<KPJ.147>
	flagga	wat,9		;bit  9	data base wait		<KPJ.130>
	flagga	why,10		;bit 10	(show) why not shown	<KPJ.121>
	flagga	cas,11		;bit 11 casify			<KPJ.116>
	flagga	mrx,12,reversed	;bit 12 marks (are) secret	<KPJ.100>
	flagga	ltr,13,reversed	;bit 13	letter priority		<KPJ.63>
	flagga	idl,14,reversed	;bit 14	idle killer		<KPJ.63>
	flagga	log,15,reversed	;bit 15 disconnect after logout [KPJ.22]
	flagga	dfr,16,reversed	;bit 16 deferred commands	[KPJ.20]
	flagga	hed,17		;bit 17 short headings		[KPJ.16]
	flagga	bel,18,reversed	;bit 18 door bell		[KPJ.3]
	flagga	net,19		;bit 19 network bug		<KPJ.160>
	flagga	avm,20,reversed	;bit 20 comment unmarks notice	[KPJ.24]
	flagga	sis,21		;bit 21 dates in ISO standard
	flagga	lfe,22		;bit 22 line feed echo
	flagga	sac,23		;bit 23 show all comments
	flagga	sar,24		;bit 24 show all receivers
	flagga	qui,25		;bit 25 QUIT first in menu
	flagga	nli,26		;bit 26 line of dashes
	flagga	rda,27		;bit 27 report disk accesses
	flagga	spa,28		;bit 28 save password
	flagga	nbr,29		;bit 29 empty line to command mode
	flagga	pre,30		;bit 30 present message
	flagga	nex,31		;bit 31 expansion of commands
	flagga	sho,32		;bit 32 short menu
	flagga	nco,33		;bit 33 command interpretation
	flagga	acr,34		;bit 34 automatic CR
	flagga	huh,35		;bit 35 login question		[KPJ.24]
;-----------------------------------
;	This is an obsolete variable. Don't change it:

	defpfl==ncopfl!nexpfl!nbrpfl!nlipfl!acrpfl!lfepfl!sispfl

;	Bits in the type word in the data base

	noclfl==1B27			;[BCQ] no cleaning flag
	oriofl==1B26			;original conference flag
	meeofl==1B25			;conference flag
	opnofl==1B24			;open conference flag
	priofl==1B23			;local printer object flag
	orgofl==1B22			;organisation object flag
IFN	ftsubj,<			;<KPJ.132>
	subofl==1B21			;subject flag
>;ftsubj
	proofl==1B20			;protected conference flag
	wprofl==1B19			;write protected conference flag
