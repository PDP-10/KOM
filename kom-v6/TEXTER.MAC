	SEARCH	kommac
	PROLOG	(texter)
texter:!

;	D E F I N I T I O N S

DEFINE	deflang	(foo)<
	..lang==0		;;start from 0
IRP	foo,<
	..lang==..lang+1	;;increment language#
DEFINE	foo	(tx)<
IFE	ftlan-.'foo,<ASCIZ tx>>
DEFINE	foo'6	(tx)<
IFE	ftlan-.'foo,<EXP <SIXBIT tx>>>
>>;End DEFINE

	deflang	(<swe,eng,nor,ger,fre>)
	PURGE	deflang,..lang

				;[KPJ.32] define subject strings
;This macro, use in TEXTER module, defines four things:
;(1)	The length of the SUBJECT text.
;(2)	The SUBJECT text for DISPLA module (not ASCIZ).
;(3)	The SUBJECT text in STRING format.
;(4)	The SUBJECT text in STRING format, with an extra colon.

DEFINE	zubjln	(foo,bar,fronk1,fronk2,fronk3,fronk4)<
IFE	ftlan-.'foo,<		;;(1)
	..foo==0
IRPC	bar,<	..foo==..foo+1>
fronk1::EXP	..foo+3		;;length (subject followed by ":  " (3 chars))
fronk2::
IRPC	bar,<	EXP	"bar">	;;one character per word, yes...
	EXP	":",.CHSPC,.CHSPC
	EXP	0
fronk3::foo	<bar>>		;;(2) here's the "string" stuff
>;End DEFINE


;	P R O G R A M   C O D E

	CODE

znone::	SWE	<(saknas)>
	NOR	<(mangler)>
	ENG	<(none)>
	GER	<(none)>
	FRE	<(none)>
zsatan::SWE	<(internt fel)>
	NOR	<(intern feil)>
	ENG	<(internal error)>
	GER	<(internal error)>
	FRE	<(internal error)>
;ADD.MAC -----------------------------------
zadyou::SWE	<M|tet finns redan i m|teslistan.>
	NOR	<M|tet finns redan i m|teslistan.>
	ENG	<Conference already present in member list.>
	GER	<Conference already present in member list.>
	FRE	<Conference already present in member list.>
	
zaddhl::SWE	<Anv{nds n{r du vill addera mottagare
eller k{nnedomsmottagare till inl{gg, eller medlemmar till m|ten.>
	NOR	<Brukes n}r du vil addere mottakere
eller underretningsmottakere til innlegg, eller medlemmer til m|ter.>
	ENG	<Used when you want to add receivers
or info copy receivers to entries, or members to meetings.>
	GER	<Used when you want to add receivers
or info copy receivers to entries, or members to meetings.>
	FRE	<Used when you want to add receivers
or info copy receivers to entries, or members to meetings.>

zwhadd::SWE	<Vad ska dessa adderas som?  >
	NOR	<Hva skal disse adderes som?  >
	ENG	<As what should these be added?  >
	GER	<As what should these be added?  >
	FRE	<As what should these be added?  >

zhladd::SWE	<Ge f|rst en lista av namn.  Ge d{refter vad dessa ska
adderas som.  Ge till sist det som dessa ska adderas till.

OBS: Kommandona MOTTAGARE, F\R K[NNEDOM och EXTRA KOPIA {r normalt
b{ttre att anv{nda {n ADDERA-kommandot.>
	NOR	<Gi f|rst en liste av navn. Gi deretter hva disse skal
adderes som.  Gi til slutt det som skal adderes til.
 
OBS: Kommandoen MOTTAGERE:, TIL UNDERRETNING: og EKSTRA KOPIER: er normalt
bedre } bruke en ADDRERE-kommandoen.>
	ENG	<First give a list of names.  Then state in what capacity
they should be added.  Last, give the object to which they should be added.

Note: The commands RECEIVER, FOR INFORMATION and SINGLE COPY are
often easier for adding receivers to an entry than the ADD command.
>
	GER	<First give a list of names.  Then state in what capacity
they should be added.  Last, give the object to which they should be added.

Note: The commands RECEIVER, FOR INFORMATION and SINGLE COPY are
often easier for adding receivers to an entry than the ADD command.
>
	FRE	<First give a list of names.  Then state in what capacity
they should be added.  Last, give the object to which they should be added.

Note: The commands RECEIVER, FOR INFORMATION and SINGLE COPY are
often easier for adding receivers to an entry than the ADD command.
>

zasadd::SWE	<Vem vill du addera?>
	NOR	<Hvem vil du addere?>
	ENG	<Whom do you want to add?>
	GER	<Whom do you want to add?>
	FRE	<Whom do you want to add?>

zareco::SWE	<(som) mottagare (till)>
	NOR	<(som) mottakere (til)>
	ENG	<(as) receivers (of)>
	GER	<(as) receivers (of)>
	FRE	<(as) receivers (of)>

zaicro::SWE	<(som) k{nnedomsmottagare (till)>
	NOR	<(som) underretningsmottakere (til)>
	ENG	<(as) info copy receivers (of)>
	GER	<(as) info copy receivers (of)>
	FRE	<(as) info copy receivers (of)>

zaexco::SWE	<(som) kopiemottagare (till)>
	NOR	<(som) kopimottakere (til)>
	ENG	<(as) single copy receiver (of)>
	GER	<(as) single copy receiver (of)>
	FRE	<(as) single copy receiver (of)>

zamemo::SWE	<(som) medlem (av)>
