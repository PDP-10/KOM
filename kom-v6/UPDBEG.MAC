ccdump::0				; dump
IFE	ftptym,<			;<KPJ.14>
	0				;<KPJ.14> (obsolete)
> IFN	ftptym,<			;<KPJ.14>
ccptmo::0				; pty mode
>;ftptym
ccaren::0				; archive entries
cccamo::0				; call monitor
ccnexc::0				; next comment
ccskco::0				; skip all commments
cclwhe::0				; where am I
cclile::0				;<KPJ.4!TTQ.5> list letters
cccate::0				;Edit (with) TECO
ccgipp::0				;Give PPN
cccend:


;	P R O G R A M   C O D E

	CODE
					;<KPJ.11>
;+
;UPDBEG		start update operation on data base, doing enqueue, and
;		setting flag that update of data base is in progress.
;		(call UPDEND to end update)
;returns	+1 always
;-

updbeg::SETOM	updflg			;flag that update is now in progress
	CALL	mkenq##			;enqueue the data base
	CALL	inpmet			;read in META file disk block
	CALL	adcoco			;update command statistics in "INFO 1"
	return


					;<KPJ.11>
;+
;INPMET		read disk block of META file.
;		Note:	META file is only one disk block (200 words octal).
;			This is "known" by the software.
;-

inpmet:	save	<nr,gp1>
	MOVEI	gp1,met			;META file#
	MOVEI	nr,firblk		;physical block# (first block in file)
	CALL	inblk##			;read disk block
	return


					;<KPJ.11>
;+
;ADCOCO		update the command count statistics in the INFO 1 buffer,
;		zeroing the internal command counts in memory.
;accepts	internal command counts (written by command parser).
;returns	+1 always
;-

adcoco:	save	<nr>

	MOVEI	nr,cccend-cccbeg-1	;#commands
adcoc1:	MOVE	t,cccbeg(nr)		;get number of commands
	ADDM	t,ccarea(nr)		;add to total
	SETZM	cccbeg(nr)		;clear command number
	SOJGE	nr,adcoc1		;loop over the commands
	return


					;<KPJ.11>
;+
;UPDEND		End of data base update:
;
;		Output all disk blocks which are marked as modified,
;		update statistics in INFO and META files,
;		dequeue data base, and clear data base update flag.
;
;	Note:	Data base update is started by calling UPDBEG routine.
;-

updend::CALL	updacc			;update read/write access statistics
	AOS	updcnt			;update #updates (in "INFO 1")
	CALL	outwri			;output modified files to disk
	CALL	mkdeq##			;dequeue the data base
	SETZM	updflg			;flag that no update in progress
	return



					;<KPJ.11>
;+
;OUTWRI		output all modified files to disk;
;		the META file always written.
;
;accepts	internal KOM control blocks
;returns	+1 always
;-

outwri:	save	<gp1,bfp,txt>		;<KPJ.4>
	MOVEI	gp1,met			;META file#
	CALL	markwr			;mark META file as modified
	CALL	gemere##		;get meta record for META file

	MOVE	gp1,metmax(bfp)		;start at highest file#
outwr1:	CALL	getbuf##		;get control block for file
	SKIPGE	bufwri(txt)		;file marked as modified?
	 JRST[	CALL	outblk##	;yes, output it's block
		JRST	.+1]
	SOJG	gp1,outwr1		;loop over files
	return


					;<KPJ.11>
;+
;UPDACC		update the read and write access statistics in the META file,
;		and deletes the statistics from control blocks in memory;
;		marks META file as modified.
;accepts	data from the internal "buffers" (really KOM control blocks).
;returns	+1 always
;-

updacc:	save	<gp1,nr,txt,bfp>
	MOVEI	gp1,met			;META file#
	CALL	markwr			;mark META file as modified
	CALL	gemere##		;get record for META file

	MOVE	gp1,metmax(bfp)		;start with highest file#
updac1:	CALL	getbuf##		;get buffer for file
	CALL	gemere##		;get meta record for file
	MOVE	nr,bufrac(txt)		;get #read accesses from buffer
	SETZM	bufrac(txt)		;zero #read accesses
	ADDM	nr,metrac(bfp)		;add #read accesses to META buffer
	MOVE	nr,bufwac(txt)		;get #write accesses
	SETZM	bufwac(txt)		;zero #write accesses
	ADDM	nr,metwac(bfp)		;add #write accesses to META buffer
	SOJG	gp1,updac1		;loop over all files
	return


					;<KPJ.11>
;+
;MARKWR		mark a file as modified in KOM control blocks
;accepts	GP1/	file#
;-

markwr::save	<txt>
	CALL	getbuf##		;get control block for file
	SETOM	bufwri(txt)		;mark it as modified
	return

	END
..and no more␀␀␀