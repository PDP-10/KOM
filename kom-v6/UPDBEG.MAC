updflg::0				;=0:no update of data base in progress
					;#0:update in progress
;-----------------------------------
;	Format of "META" block

metsta::BLOCK	2*blksiz		;MET buffer area
;-----------------------------------
;	Format of "INFO 1" record	<KPJ.11>

infsta::BLOCK	firwrd			;start of INF buffer area

	BYTE	(9)inf(27)1		;record#		(INFO 1)
laslnk::BYTE	(9)lnk(27)0		;highest used LINK#	(LINK nnn)
lastex::BYTE	(9)tex(27)0		;highest used LINE#	(LINE nnn)
lasmar::BYTE	(9)mar(27)0		;highest used MARK#	(MARK nnn)
IFE	ftempl,<0>			;<KPJ.20>
IFN	ftempl,<			;<KPJ.20>
lasemp::BYTE	(9)emp(27)0		;highest used EMPLOYEE#	(EMPLOYEE nnn)
>;ftempl
lasdir::BYTE	(9)dir(27)0		;highest used TEXT#	(TEXT nnn)
	BLOCK	3			;(reserved)
;-----------------------------------
;NOTE: 	If you add any special conferences, also add them to the
;	SYSTEM INFORMATION display (routine PRINFO@SYSINF)
;-----------------------------------
anounc::0				;receiver of conference announcements
perpre::0				;receiver of user announcements
comadm::0				;KOM administrator (or 0)
lappar::0				;receiver of notes to letter writers
	BLOCK	2			;(reserved)
updcnt::0				;update version count
timsum::0				;total sum of present time
redsum::0				;total #read entries
	2				;(mintim) minimal time (days)
sysmes::0				;current system message	(TEXT nnn)
nrmeet::0				;#OPEN
	0				;#CLOSED
	0				;#WRITE PROTECTED OPEN
	0				;#WRITE PROTECTED CLOSED
	0				;#PROTECTED
	0				;#SUBJECT
nrorgs::0				;#ORGANISATION
	0				;#PRINTER
	0				;#ORIGINAL OPEN
	0				;#ORIGINAL CLOSED
	BLOCK	6			;(reserved)
	BLOCK	blksiz-.+infsta

;-----------------------------------
;	Format of "INFO 2" block	<KPJ.11>

	BLOCK	firwrd

	BYTE	(9)inf(27)2		;record number (INFO 2)
ccarea::BLOCK	blksiz-1		;command count area
;-----------------------------------
cccbeg::				;start of command count field
cccowr::0				; continue write
ccfien::0				; finish entry
ccreli::0				; remove line
ccrewo::0				; remove word
ccsufi::0				; submit file
ccaden::0				; add entry
cctywh::0				; type whole
ccdeen::0				; delete entry
ccdesp::0				; define special meetings
ccadre::0				; add receivers
ccknre::0				; info copy receivers
ccmoen::0				; move entry
ccmafi::0				; make file
ccrevi::0				; review entry
cctyfi::0				; type file
ccwrit::0				; write entry
ccmkle::0				; make letter
ccmkco::0				; make comment
ccmkan::0				; make answer
ccmksy::0				; system message
ccquit::0				; quit
ccolco::0				; old com
ccneco::0				; new com
ccenco::0				; english com
